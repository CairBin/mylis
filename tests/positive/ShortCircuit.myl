import { println_bool } from "Io.myl";

fn markBool(bool v) -> bool {
    println_bool(v);
    return v;
}

fn main() -> i32 {
    u8[] b = new u8[3];
    i64 n = 3;
    i64 i = 3;
    bool a = i < n && b[i] == 9;
    println_bool(a);
    bool c = i >= n || b[i] == 9;
    println_bool(c);
    bool d = false && b[i] == 9;
    println_bool(d);
    bool e = true || b[i] == 9;
    println_bool(e);

    println_bool(markBool(true) && markBool(false));
    println_bool(false && markBool(true));
    println_bool(true || markBool(false));
    println_bool(markBool(false) || markBool(true));
    println_bool(markBool(true) && (markBool(false) || markBool(true)));
    return 0;
}
