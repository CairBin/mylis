import { Io, print, println, print_i32, println_i32, print_i8, println_i8, print_i16, println_i16, print_i64, print_u8, println_u8, print_u16, println_u16, print_u32, println_u32, print_u64, print_f32, println_f32, print_f64, print_bool, println_i64, println_u64, println_f64, println_bool } from "Io.myl";

pub class Arrays {
    pub i32[] data;

    pub fn init(i32[] d) -> void {
        this.data = d;
    }

    pub fn total() -> i32 {
        i32 sum = 0;
        for (i32 i = 0; i < this.data.len(); i = i + 1) {
            sum = sum + this.data[i];
        }
        return sum;
    }
}

fn main() -> i32 {
    i32[] a = [3, 1, 4, 1, 5];
    println("len = {a.len()}");
    println("a = {a}");
    i32[] z = new i32[3];
    z[0] = 10;
    z[2] = 20;
    println("z = {z}");
    Arrays box = new Arrays(a);
    println("total = {box.total()}");
    z[1] = a[0] + a[4];
    println("z = {z}");
    string[] names = ["alpha", "beta"];
    println("names = {names}");
    return 0;
}
