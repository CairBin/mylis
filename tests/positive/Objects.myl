import { Io, print, println, print_i32, println_i32, print_i8, println_i8, print_i16, println_i16, print_i64, print_u8, println_u8, print_u16, println_u16, print_u32, println_u32, print_u64, print_f32, println_f32, print_f64, print_bool, println_i64, println_u64, println_f64, println_bool } from "Io.myl";

pub class Objects {
}

class Point {
    pub i32 x;
    pub i32 y;
    i32 cached = 0;

    pub fn init(i32 x, i32 y) -> void {
        this.x = x;
        this.y = y;
    }

    pub fn sum() -> i32 {
        this.cached = this.x + this.y;
        return this.cached;
    }

    pub fn shift(i32 d) -> void {
        this.x = this.x + d;
        this.y = this.y + d;
    }
}

pub fn main() -> i32 {
    Point p = new Point(3, 4);
    println_i32(p.sum());
    p.shift(10);
    println_i32(p.x);
    println_i32(p.sum());
    p.cached = 99;
    println_i32(p.cached);
    return 0;
}
