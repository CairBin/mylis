import { println, println_i32, println_i64, println_bool } from "Io.myl";

interface I32 {
    fn get() -> i32;
}

class B {
    i32 v;
    pub fn init(i32 n) { this.v = n; }
    pub fn get() -> i32 { return this.v; }
    pub fn set(i32 n) { this.v = n; }
    pub static fn combine(i64 a, i64 b) -> i64 { return a + b; }
}

fn mark(i64 v) -> i64 {
    println_i64(v);
    return v;
}

fn add(i64 a, i64 b) -> i64 {
    return a + b;
}

fn cmp(i64 a, i64 b) -> bool {
    return a < b;
}

enum Pair {
    P(i32, i32),
}

fn mark32(i32 v) -> i32 {
    println_i32(v);
    return v;
}

fn makeB() -> B {
    println_i64(6);
    return new B(0);
}

fn makeI32() -> I32 {
    println_i64(5);
    B b = new B(5);
    I32 i = b as I32;
    return i;
}

fn main() -> i32 {
    println_i64(add(mark(1), mark(2)));
    println_bool(cmp(mark(3), mark(4)));

    Option<I32> o = Some(makeI32());
    println_i32(o.unwrap().get());

    Result<I32, string> r = Ok(makeI32());
    println_i32(r.unwrap().get());

    Result<string, I32> e = Err(makeI32());
    println_i32(e.unwrap_err().get());

    B b = new B(mark(7) as i32);
    println_i32(b.get());
    b.set(mark(8) as i32);
    makeB().set(mark(9) as i32);

    println_i64(mark(10) + mark(11));
    println_i64(B::combine(mark(12), mark(13)));
    println_i32(mark32(14).compare(mark32(15)));

    Pair p = Pair::P(mark32(16), mark32(17));
    match p {
        Pair::P(x, y) => {
            println_i32(x);
            println_i32(y);
        }
    }

    println("{mark32(18)} {mark32(19)}");
    i32[] ar = [mark32(20), mark32(21)];
    println_i32(ar[0]);
    println_i32(ar[1]);
    return 0;
}
