import { Io, print, println, print_i32, println_i32, print_i8, println_i8, print_i16, println_i16, print_i64, print_u8, println_u8, print_u16, println_u16, print_u32, println_u32, print_u64, print_f32, println_f32, print_f64, print_bool, println_i64, println_u64, println_f64, println_bool } from "Io.myl";

pub type Int = i32;
type Pair = Int[];
type Name = string;

class Box {
    Pair items;
    pub fn init(Pair items) { this.items = items; }
    pub fn first() -> Int { return this.items[0]; }
}

fn hello(Name who) -> Name {
    return "hi, {who}";
}

pub fn main() -> i32 {
    Int a = 5;
    Pair p = [1, 2, 3];
    Box b = new Box(p);
    println_i32(a);
    println_i32(b.first());
    println(hello("mylis"));
    return 0;
}
