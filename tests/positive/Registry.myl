import { Io, print, println, print_i32, println_i32, print_i8, println_i8, print_i16, println_i16, print_i64, print_u8, println_u8, print_u16, println_u16, print_u32, println_u32, print_u64, print_f32, println_f32, print_f64, print_bool, println_i64, println_u64, println_f64, println_bool } from "Io.myl";

pub class Registry {
    pub static i32 count = 0;
    pub static string title = "registry";

    pub static fn next() -> i32 {
        Registry::count = Registry::count + 1;
        return Registry::count;
    }

    pub static fn describe() -> string {
        return "{Registry::title}: {Registry::count}";
    }
}

class Item {
    pub i32 id;

    pub fn init() -> void {
        this.id = Registry::next();
    }
}

fn main() -> i32 {
    Item a = new Item();
    Item b = new Item();
    Item c = new Item();
    println("ids {a.id} {b.id} {c.id}");
    println(Registry::describe());
    Registry::title = "items";
    println(Registry::describe());
    return 0;
}
