import { Io, print, println, print_i32, println_i32, print_i8, println_i8, print_i16, println_i16, print_i64, print_u8, println_u8, print_u16, println_u16, print_u32, println_u32, print_u64, print_f32, println_f32, print_f64, print_bool, println_i64, println_u64, println_f64, println_bool } from "Io.myl";

interface Show {
    fn label() -> string;
    fn to_string() -> string;
}

enum Shape {
    Circle(f64),
    Rect(f64, f64),
    Empty,

    pub fn area() -> f64 {
        match this {
            Shape::Circle(r) => { return 3.14 * r * r; }
            Shape::Rect(w, h) => { return w * h; }
            Shape::Empty => { return 0.0; }
        }
    }

    pub fn label() -> string {
        match this {
            Shape::Circle(_r) => { return "circle"; }
            Shape::Rect(_w, _h) => { return "rect"; }
            Shape::Empty => { return "empty"; }
        }
    }

    pub fn to_string() -> string {
        match this {
            Shape::Circle(r) => { return "C({r})"; }
            Shape::Rect(w, h) => { return "R({w}x{h})"; }
            Shape::Empty => { return "E"; }
        }
    }

    pub static fn unit() -> Shape { return Shape::Empty; }
}

enum Msg {
    Quit,
    Move(i32, i32),
}

fn dump(Msg m) -> string {
    match m {
        Msg::Quit => { return "quit"; }
        Msg::Move(x, y) => { return "move({x},{y})"; }
    }
}

fn main() -> i32 {
    Shape c = Shape::Circle(2.0);
    Shape r = Shape::Rect(3.0, 4.0);
    Shape e = Shape::unit();
    println("{c} area={c.area()} label={c.label()}");
    println("{r} area={r.area()} label={r.label()}");
    println("{e} area={e.area()} label={e.label()}");

    Show s = Shape::Rect(1.0, 2.0);
    println("iface = {s.label()} / {s}");

    Msg m1 = Msg::Quit;
    Msg m2 = Msg::Move(5, -3);
    println("{dump(m1)} | {dump(m2)}");

    Shape[] all = [Shape::Circle(1.0), Shape::Empty, Shape::Rect(2.0, 2.0)];
    println("all = {all}");
    return 0;
}
