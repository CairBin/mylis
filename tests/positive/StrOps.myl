import { println, println_bool } from "Io.myl";
import { Fmt } from "Fmt.myl";
import { Str } from "Str.myl";
import { Ordering } from "Ordering.myl";

fn main() -> i32 {
    println_bool(Str::StartsWith("hello", "he"));
    println_bool(Str::EndsWith("hello", "lo"));
    println_bool(Str::Contains("hello", "ell"));
    println(Fmt::I64(Str::IndexOf("hello", "ll")));
    println(Fmt::I64(Str::IndexOf("hello", "zz")));
    println(Str::Trim("  hi \n"));
    println(Str::Substring("hello", 1, 3));
    println(Str::Substring("hello", 9, 3));
    println(Str::Repeat("ab", 3));
    println("[" + Str::Repeat("x", 0) + "]");
    println(Str::Replace("a-b-a", "a", "x"));

    Ordering o = Str::CompareOrdering("a", "b");
    match o {
        Ordering::Less => { println("less"); }
        Ordering::Equal => { println("equal"); }
        Ordering::Greater => { println("greater"); }
    }
    return 0;
}
