// Unicode 其余通用类别子类、C 类与 Any/ASCII/Assigned。
import { Regex } from "Regex.myl";
import { Str } from "core/Str";
import { IoError } from "IoError.myl";
import { println_bool } from "Io.myl";

fn check(string pattern, string text) -> void {
    Result<Regex, IoError> result = Regex::Compile(pattern);
    match result {
        Ok(regex) => { println_bool(regex.isMatch(text)); }
        Err(_) => { println_bool(false); }
    }
}

fn checkBytes(string pattern, u8[] data) -> void {
    Result<Regex, IoError> result = Regex::Compile(pattern);
    match result {
        Ok(regex) => { println_bool(regex.isMatch(Str::FromBytes(data))); }
        Err(_) => { println_bool(false); }
    }
}

fn main() -> i32 {
    check("\\p{{Pc}}", "_");
    check("\\p{{Pc}}", "a");
    check("\\p{{Pd}}", "-");
    check("\\p{{Ps}}", "(");
    check("\\p{{Pe}}", ")");
    check("\\p{{Pi}}", "«");
    check("\\p{{Pf}}", "»");
    check("\\p{{Po}}", "!");
    check("\\p{{Sm}}", "+");
    check("\\p{{Sc}}", "$");
    check("\\p{{Sk}}", "^");
    check("\\p{{So}}", "©");
    check("\\p{{Zs}}", " ");
    check("\\p{{Cc}}", "\n");
    check("\\p{{Co}}", "");
    check("\\p{{C}}", "");
    check("\\p{{C}}", "a");
    check("\\p{{Any}}", "\\n");
    check("\\p{{ASCII}}", "a");
    check("\\p{{ASCII}}", "Ω");
    check("\\p{{Assigned}}", "a");
    check("\\p{{Assigned}}", "");

    u8[] zl = new u8[3];
    zl[0] = 226; zl[1] = 128; zl[2] = 168;
    u8[] zp = new u8[3];
    zp[0] = 226; zp[1] = 128; zp[2] = 169;
    u8[] zwsp = new u8[3];
    zwsp[0] = 226; zwsp[1] = 128; zwsp[2] = 139;
    u8[] unassigned = new u8[2];
    unassigned[0] = 205; unassigned[1] = 184;
    checkBytes("\\p{{Zl}}", zl);
    checkBytes("\\p{{Zp}}", zp);
    checkBytes("\\p{{Cf}}", zwsp);
    checkBytes("\\p{{Cn}}", unassigned);
    checkBytes("\\p{{Assigned}}", unassigned);
    checkBytes("\\p{{C}}", zwsp);

    check("\\p{{Connector_Punctuation}}", "_");
    check("\\p{{Dash_Punctuation}}", "-");
    check("\\p{{Open_Punctuation}}", "(");
    check("\\p{{Close_Punctuation}}", ")");
    check("\\p{{Initial_Punctuation}}", "«");
    check("\\p{{Final_Punctuation}}", "»");
    check("\\p{{Other_Punctuation}}", "!");
    check("\\p{{Math_Symbol}}", "+");
    check("\\p{{Currency_Symbol}}", "$");
    check("\\p{{Modifier_Symbol}}", "^");
    check("\\p{{Other_Symbol}}", "©");
    check("\\p{{Space_Separator}}", " ");
    check("\\p{{Control}}", "\n");
    checkBytes("\\p{{Format}}", zwsp);
    check("\\p{{Private_Use}}", "");
    checkBytes("\\p{{Unassigned}}", unassigned);
    check("\\p{{Other}}", "");
    return 0;
}
