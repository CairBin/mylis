import { EventLoop } from "EventLoop.myl";
import { UdpEventLoop } from "UdpEventLoop.myl";
import { UdpHandler } from "UdpHandler.myl";
import { UdpSocket } from "UdpSocket.myl";
import { UdpPacket } from "UdpPacket.myl";
import { IoError } from "IoError.myl";
import { println_i64, println_bool } from "Io.myl";
import { Str } from "core/Str";
import { fmt_i64 } from "core/Fmt";

class UdpReadHandler {
    EventLoop loop;

    pub fn init(EventLoop l) -> void {
        this.loop = l;
    }

    pub fn onUdpReadable(UdpSocket socket) -> void {
        Result<UdpPacket, IoError> got = socket.recvFrom(4);
        match got {
            Ok(packet) => {
                println_i64(packet.data.len() as i64);
                println_i64(packet.data[0] as i64);
                println_bool(Str::Contains(packet.from, "127.0.0.1"));
            }
            Err(e) => { println_i64(e.code as i64); }
        }
        this.loop.stop();
    }

    pub fn onUdpError(UdpSocket socket, IoError error) -> void {
        println_i64(error.code as i64);
        this.loop.stop();
    }
}

fn main() -> i32 {
    Result<UdpSocket, IoError> boundA = UdpSocket::Bind("127.0.0.1:0");
    Result<UdpSocket, IoError> boundB = UdpSocket::Bind("127.0.0.1:0");
    match boundA {
        Ok(a) => {
            match boundB {
                Ok(b) => {
                    i64 portA = a.localPort();
                    i64 portB = b.localPort();
                    println_bool(portA > 0);
                    println_bool(portB > 0);
                    string addrA = Str::Concat("127.0.0.1:", fmt_i64(portA));
                    b.sendText(addrA, "ping");

                    EventLoop loop = new EventLoop();
                    UdpEventLoop udp = new UdpEventLoop(loop);
                    UdpReadHandler handler = new UdpReadHandler(loop);
                    UdpHandler ih = handler;
                    udp.addSocket(a, ih);
                    loop.run();
                    udp.removeSocket(a);
                    loop.close();
                    b.close();
                }
                Err(e) => { println_i64(e.code as i64); }
            }
            a.close();
        }
        Err(e) => { println_i64(e.code as i64); }
    }
    println_bool(true);
    return 0;
}
