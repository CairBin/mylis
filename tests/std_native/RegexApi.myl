import { Regex } from "Regex.myl";
import { RegexMatch } from "RegexMatch.myl";
import { RegexCaptures } from "RegexCaptures.myl";
import { Vec } from "Vec.myl";
import { IoError } from "IoError.myl";
import { println, println_bool, println_i64 } from "Io.myl";

fn main() -> i32 {
    Result<Regex, IoError> compiled = Regex::Compile("^hello");
    match compiled {
        Ok(firstPattern) => {
            println_bool(firstPattern.isMatch("hello world"));
            println_bool(firstPattern.isMatch("well hello"));
        }
        Err(_) => { println("compile-error"); }
    }

    Result<Regex, IoError> wordResult = Regex::Compile("[a-z]+");
    match wordResult {
        Ok(wordPattern) => {
            Option<RegexMatch> found = wordPattern.find("123abc456");
            match found {
                Some(firstMatch) => {
                    println_i64(firstMatch.start);
                    println_i64(firstMatch.end);
                    println(firstMatch.text("123abc456"));
                }
                None => { println("none"); }
            }
            println(wordPattern.replaceAll("abc 12 def", "_"));
        }
        Err(_) => { println("compile-error"); }
    }

    Result<Regex, IoError> altResult = Regex::Compile("(foo|bar)+!");
    match altResult {
        Ok(altPattern) => {
            println_bool(altPattern.isMatch("foobar!"));
            println_bool(altPattern.isMatch("foobaz!"));
        }
        Err(_) => { println("compile-error"); }
    }

    Result<Regex, IoError> numberResult = Regex::Compile("\\d+");
    match numberResult {
        Ok(numberPattern) => {
            println_bool(numberPattern.isMatch("x42"));
        }
        Err(_) => { println("compile-error"); }
    }

    Result<Regex, IoError> endResult = Regex::Compile("world$");
    match endResult {
        Ok(endPattern) => {
            println_bool(endPattern.isMatch("hello world"));
            println_bool(endPattern.isMatch("world hello"));
        }
        Err(_) => { println("compile-error"); }
    }

    Result<Regex, IoError> boundedResult = Regex::Compile("^a{{2,4}}$");
    match boundedResult {
        Ok(boundedPattern) => {
            println_bool(boundedPattern.isMatch("aa"));
            println_bool(boundedPattern.isMatch("aaaa"));
            println_bool(boundedPattern.isMatch("aaaaa"));
            println_bool(boundedPattern.isMatch("a"));
        }
        Err(_) => { println("compile-error"); }
    }

    Result<Regex, IoError> openResult = Regex::Compile("^a{{2,}}$");
    match openResult {
        Ok(openPattern) => {
            println_bool(openPattern.isMatch("aa"));
            println_bool(openPattern.isMatch("aaaaa"));
            println_bool(openPattern.isMatch("a"));
        }
        Err(_) => { println("compile-error"); }
    }

    Result<Regex, IoError> zeroResult = Regex::Compile("^a{{0,2}}$");
    match zeroResult {
        Ok(zeroPattern) => {
            println_bool(zeroPattern.isMatch(""));
            println_bool(zeroPattern.isMatch("aa"));
            println_bool(zeroPattern.isMatch("aaa"));
        }
        Err(_) => { println("compile-error"); }
    }

    Result<Regex, IoError> badBrace = Regex::Compile("a{{");
    match badBrace {
        Ok(_) => { println("unexpected-ok"); }
        Err(_) => { println("bad-brace-error"); }
    }

    Result<Regex, IoError> badClass = Regex::Compile("[abc");
    match badClass {
        Ok(_) => { println("unexpected-ok"); }
        Err(_) => { println("bad-class-error"); }
    }

    Result<Regex, IoError> captureResult = Regex::Compile("(a+)(b+)");
    match captureResult {
        Ok(capturePattern) => {
            Option<RegexCaptures> found = capturePattern.findCaptures("xxaaabbbxx");
            match found {
                Some(caps) => {
                    println_i64(caps.groupCount() as i64);
                    println(caps.text("xxaaabbbxx", 0));
                    println(caps.text("xxaaabbbxx", 1));
                    println(caps.text("xxaaabbbxx", 2));
                }
                None => { println("capture-none"); }
            }
        }
        Err(_) => { println("capture-compile-error"); }
    }

    Result<Regex, IoError> nestedResult = Regex::Compile("((a)(b))");
    match nestedResult {
        Ok(nestedPattern) => {
            Option<RegexCaptures> nestedFound = nestedPattern.findCaptures("ab");
            match nestedFound {
                Some(caps) => {
                    println_i64(caps.groupCount() as i64);
                    println(caps.text("ab", 1));
                    println(caps.text("ab", 2));
                    println(caps.text("ab", 3));
                }
                None => { println("nested-none"); }
            }
        }
        Err(_) => { println("nested-compile-error"); }
    }

    Result<Regex, IoError> optionalResult = Regex::Compile("(a)?(b)");
    match optionalResult {
        Ok(optionalPattern) => {
            Option<RegexCaptures> optionalFound = optionalPattern.findCaptures("b");
            match optionalFound {
                Some(caps) => {
                    match caps.group(1) {
                        Some(_) => { println("optional-present"); }
                        None => { println("optional-none"); }
                    }
                    println(caps.text("b", 2));
                }
                None => { println("optional-none"); }
            }
        }
        Err(_) => { println("optional-compile-error"); }
    }

    Result<Regex, IoError> nonCaptureResult = Regex::Compile("(?:foo|bar)+!");
    match nonCaptureResult {
        Ok(nonCapturePattern) => {
            Option<RegexCaptures> nonCaptureFound = nonCapturePattern.findCaptures("foobar!");
            match nonCaptureFound {
                Some(caps) => {
                    println_i64(caps.groupCount() as i64);
                    println(caps.text("foobar!", 0));
                }
                None => { println("noncapture-none"); }
            }
        }
        Err(_) => { println("noncapture-compile-error"); }
    }

    Result<Regex, IoError> backtrackResult = Regex::Compile("(a|ab)c");
    match backtrackResult {
        Ok(backtrackPattern) => {
            Option<RegexCaptures> backtrackFound = backtrackPattern.findCaptures("abc");
            match backtrackFound {
                Some(caps) => {
                    println(caps.text("abc", 0));
                    println(caps.text("abc", 1));
                }
                None => { println("backtrack-none"); }
            }
        }
        Err(_) => { println("backtrack-compile-error"); }
    }

    Result<Regex, IoError> repeatCaptureResult = Regex::Compile("(ab)+");
    match repeatCaptureResult {
        Ok(repeatPattern) => {
            Option<RegexCaptures> repeatFound = repeatPattern.findCaptures("abab");
            match repeatFound {
                Some(caps) => {
                    println_i64(caps.groupCount() as i64);
                    println(caps.text("abab", 0));
                    println(caps.text("abab", 1));
                }
                None => { println("repeat-none"); }
            }
        }
        Err(_) => { println("repeat-compile-error"); }
    }

    Result<Regex, IoError> nestedRepeatResult = Regex::Compile("((a)+)");
    match nestedRepeatResult {
        Ok(nestedRepeatPattern) => {
            Option<RegexCaptures> nestedRepeatFound = nestedRepeatPattern.findCaptures("aaa");
            match nestedRepeatFound {
                Some(caps) => {
                    println_i64(caps.groupCount() as i64);
                    println(caps.text("aaa", 1));
                    println(caps.text("aaa", 2));
                }
                None => { println("nested-repeat-none"); }
            }
        }
        Err(_) => { println("nested-repeat-compile-error"); }
    }

    Result<Regex, IoError> lookResult = Regex::Compile("foo(?=bar)");
    match lookResult {
        Ok(lookPattern) => {
            println_bool(lookPattern.isMatch("foobar"));
            println_bool(lookPattern.isMatch("foobaz"));
            Option<RegexMatch> lookFound = lookPattern.find("xxfoobar");
            match lookFound {
                Some(value) => {
                    println_i64(value.start);
                    println_i64(value.end);
                    println(value.text("xxfoobar"));
                }
                None => { println("look-none"); }
            }
        }
        Err(_) => { println("look-compile-error"); }
    }

    Result<Regex, IoError> negativeLookResult = Regex::Compile("foo(?!bar)");
    match negativeLookResult {
        Ok(negativeLookPattern) => {
            println_bool(negativeLookPattern.isMatch("foobaz"));
            println_bool(negativeLookPattern.isMatch("foobar"));
        }
        Err(_) => { println("negative-look-compile-error"); }
    }

    Result<Regex, IoError> lookCaptureResult = Regex::Compile("(a)(?=(b))");
    match lookCaptureResult {
        Ok(lookCapturePattern) => {
            Option<RegexCaptures> lookCaptureFound = lookCapturePattern.findCaptures("ab");
            match lookCaptureFound {
                Some(caps) => {
                    println_i64(caps.groupCount() as i64);
                    println(caps.text("ab", 0));
                    println(caps.text("ab", 1));
                    println(caps.text("ab", 2));
                }
                None => { println("look-capture-none"); }
            }
        }
        Err(_) => { println("look-capture-compile-error"); }
    }

    Result<Regex, IoError> nestedLookResult = Regex::Compile("a(?=b(?=c))");
    match nestedLookResult {
        Ok(nestedLookPattern) => {
            println_bool(nestedLookPattern.isMatch("abc"));
            println_bool(nestedLookPattern.isMatch("abd"));
        }
        Err(_) => { println("nested-look-compile-error"); }
    }

    Result<Regex, IoError> lookAllResult = Regex::Compile("a(?=b)");
    match lookAllResult {
        Ok(lookAllPattern) => {
            Vec<RegexMatch> lookMatches = lookAllPattern.findAll("abab");
            println_i64(lookMatches.len());
            if (lookMatches.len() > 0) {
                println_i64(lookMatches.get(0).start);
            }
            if (lookMatches.len() > 1) {
                println_i64(lookMatches.get(1).start);
            }
        }
        Err(_) => { println("look-all-compile-error"); }
    }

    Result<Regex, IoError> longestLookResult = Regex::Compile("a(?=b)|ab");
    match longestLookResult {
        Ok(longestLookPattern) => {
            Option<RegexMatch> longestFound = longestLookPattern.find("ab");
            match longestFound {
                Some(value) => { println_i64(value.end); }
                None => { println("longest-look-none"); }
            }
        }
        Err(_) => { println("longest-look-compile-error"); }
    }

    Result<Regex, IoError> behindResult = Regex::Compile("(?<=foo)bar");
    match behindResult {
        Ok(behindPattern) => {
            println_bool(behindPattern.isMatch("foobar"));
            println_bool(behindPattern.isMatch("barfoo"));
            Option<RegexMatch> behindFound = behindPattern.find("xxfoobar");
            match behindFound {
                Some(value) => {
                    println_i64(value.start);
                    println_i64(value.end);
                    println(value.text("xxfoobar"));
                }
                None => { println("behind-none"); }
            }
        }
        Err(_) => { println("behind-compile-error"); }
    }

    Result<Regex, IoError> negativeBehindResult = Regex::Compile("(?<!foo)bar");
    match negativeBehindResult {
        Ok(negativeBehindPattern) => {
            println_bool(negativeBehindPattern.isMatch("bazbar"));
            println_bool(negativeBehindPattern.isMatch("foobar"));
        }
        Err(_) => { println("negative-behind-compile-error"); }
    }

    Result<Regex, IoError> variableBehindResult = Regex::Compile("(?<=a|bc)d");
    match variableBehindResult {
        Ok(variableBehindPattern) => {
            println_bool(variableBehindPattern.isMatch("ad"));
            println_bool(variableBehindPattern.isMatch("bcd"));
            println_bool(variableBehindPattern.isMatch("xd"));
        }
        Err(_) => { println("variable-behind-compile-error"); }
    }

    Result<Regex, IoError> behindCaptureResult = Regex::Compile("(?<=(a))b");
    match behindCaptureResult {
        Ok(behindCapturePattern) => {
            Option<RegexCaptures> behindCaptureFound = behindCapturePattern.findCaptures("ab");
            match behindCaptureFound {
                Some(caps) => {
                    println_i64(caps.groupCount() as i64);
                    println(caps.text("ab", 0));
                    println(caps.text("ab", 1));
                }
                None => { println("behind-capture-none"); }
            }
        }
        Err(_) => { println("behind-capture-compile-error"); }
    }

    Result<Regex, IoError> behindAllResult = Regex::Compile("(?<=a)b");
    match behindAllResult {
        Ok(behindAllPattern) => {
            Vec<RegexMatch> behindMatches = behindAllPattern.findAll("abab");
            println_i64(behindMatches.len());
            if (behindMatches.len() > 0) {
                println_i64(behindMatches.get(0).start);
            }
            if (behindMatches.len() > 1) {
                println_i64(behindMatches.get(1).start);
            }
        }
        Err(_) => { println("behind-all-compile-error"); }
    }

    Result<Regex, IoError> behindBackrefResult = Regex::Compile("(?<=(a)\\1)b");
    match behindBackrefResult {
        Ok(behindBackrefPattern) => {
            println_bool(behindBackrefPattern.isMatch("aab"));
            println_bool(behindBackrefPattern.isMatch("ab"));
        }
        Err(_) => { println("behind-backref-compile-error"); }
    }

    Result<Regex, IoError> lookLeakResult = Regex::Compile("((?=(a))ab|ac)");
    match lookLeakResult {
        Ok(lookLeakPattern) => {
            Option<RegexCaptures> lookLeakFound = lookLeakPattern.findCaptures("ac");
            match lookLeakFound {
                Some(caps) => {
                    println_i64(caps.groupCount() as i64);
                    println(caps.text("ac", 0));
                    match caps.group(2) {
                        Some(_) => { println("look-leak-bad"); }
                        None => { println("look-leak-none"); }
                    }
                    println(caps.text("ac", 1));
                }
                None => { println("look-leak-capture-none"); }
            }
        }
        Err(_) => { println("look-leak-compile-error"); }
    }

    Result<Regex, IoError> backrefResult = Regex::Compile("(a)\\1");
    match backrefResult {
        Ok(backrefPattern) => {
            println_bool(backrefPattern.isMatch("aa"));
            println_bool(backrefPattern.isMatch("ab"));
            Option<RegexMatch> backrefFound = backrefPattern.find("xaa");
            match backrefFound {
                Some(value) => {
                    println_i64(value.start);
                    println_i64(value.end);
                    println(value.text("xaa"));
                }
                None => { println("backref-none"); }
            }
            Option<RegexCaptures> backrefCaps = backrefPattern.findCaptures("aa");
            match backrefCaps {
                Some(caps) => { println(caps.text("aa", 1)); }
                None => { println("backref-capture-none"); }
            }
        }
        Err(_) => { println("backref-compile-error"); }
    }

    Result<Regex, IoError> multiBackrefResult = Regex::Compile("(ab)\\1");
    match multiBackrefResult {
        Ok(multiBackrefPattern) => {
            println_bool(multiBackrefPattern.isMatch("abab"));
            println_bool(multiBackrefPattern.isMatch("abac"));
        }
        Err(_) => { println("multi-backref-compile-error"); }
    }

    Result<Regex, IoError> altBackrefResult = Regex::Compile("(a|b)\\1");
    match altBackrefResult {
        Ok(altBackrefPattern) => {
            println_bool(altBackrefPattern.isMatch("bb"));
            println_bool(altBackrefPattern.isMatch("ab"));
        }
        Err(_) => { println("alt-backref-compile-error"); }
    }

    Result<Regex, IoError> longestBackrefResult = Regex::Compile("(a|ab)\\1");
    match longestBackrefResult {
        Ok(longestBackrefPattern) => {
            Option<RegexMatch> longestBackrefFound = longestBackrefPattern.find("abab");
            match longestBackrefFound {
                Some(value) => { println_i64(value.end); }
                None => { println("longest-backref-none"); }
            }
        }
        Err(_) => { println("longest-backref-compile-error"); }
    }

    Result<Regex, IoError> optionalBackrefResult = Regex::Compile("(a)?\\1");
    match optionalBackrefResult {
        Ok(optionalBackrefPattern) => {
            println_bool(optionalBackrefPattern.isMatch("aa"));
            println_bool(optionalBackrefPattern.isMatch("a"));
        }
        Err(_) => { println("optional-backref-compile-error"); }
    }

    Result<Regex, IoError> forwardBackrefResult = Regex::Compile("\\1(a)");
    match forwardBackrefResult {
        Ok(_) => { println("forward-backref-supported"); }
        Err(_) => { println("forward-backref-error"); }
    }

    Result<Regex, IoError> secondBackrefResult = Regex::Compile("(a)(b)\\2\\1");
    match secondBackrefResult {
        Ok(secondBackrefPattern) => {
            println_bool(secondBackrefPattern.isMatch("abba"));
            println_bool(secondBackrefPattern.isMatch("abab"));
        }
        Err(_) => { println("second-backref-compile-error"); }
    }

    return 0;
}
