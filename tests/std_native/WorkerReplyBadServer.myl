import { Stdio } from "Stdio.myl";
import { println } from "Io.myl";

fn main() -> i32 {
    while (true) {
        Option<string> line = Stdio::ReadLine();
        match (line) {
            None => { return 0; }
            Some(request) => {
                if (request == "__shutdown__") { return 0; }
                if (request == "raw") {
                    println("not-json");
                } else if (request == "novalue") {
                    println("{{\"ok\":true}}");
                } else if (request == "nocode") {
                    println("{{\"ok\":false,\"message\":\"m\"}}");
                } else if (request == "badtype") {
                    println("{{\"ok\":1}}");
                } else {
                    println("{{\"foo\":1}}");
                }
            }
        }
    }
    return 0;
}
