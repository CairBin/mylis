import { WorkerPool } from "WorkerPool.myl";
import { WorkerTaskResult } from "WorkerTaskResult.myl";
import { IoError } from "IoError.myl";
import { Stdio } from "Stdio.myl";
import { Vec } from "Vec.myl";
import { println, println_i64 } from "Io.myl";

fn main() -> i32 {
    Option<string> command = Stdio::Env("WORKER_CMD");
    match (command) {
        None => { println("missing-worker"); return 1; }
        Some(path) => {
            Result<WorkerPool, IoError> spawned = WorkerPool::Spawn(path, 2);
            match (spawned) {
                Ok(pool) => {
                    Vec<string> tasks = new Vec<string>();
                    tasks.push("a");
                    tasks.push("boom");
                    tasks.push("c");
                    tasks.push("d");
                    Result<Vec<WorkerTaskResult>, IoError> results = pool.callAllResults(tasks, 1000);
                    match (results) {
                        Ok(values) => {
                            i64 i = 0;
                            while (i < values.len) {
                                WorkerTaskResult item = values.get(i);
                                if (item.ok) {
                                    println("ok:" + item.value);
                                } else {
                                    println_i64(item.code as i64);
                                }
                                i = i + 1;
                            }
                        }
                        Err(error) => { println_i64(error.code as i64); }
                    }
                    Result<i64, IoError> closed = pool.close();
                    match (closed) { Ok(n1) => { println_i64(n1); } Err(error2) => { println_i64(error2.code as i64); } }
                }
                Err(error3) => { println_i64(error3.code as i64); }
            }
        }
    }
    return 0;
}
