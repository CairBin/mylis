import { File } from "File.myl";
import { Path } from "Path.myl";
import { DirWatcher } from "DirWatcher.myl";
import { DirEvent } from "DirEvent.myl";
import { IoError } from "IoError.myl";
import { Vec } from "Vec.myl";
import { println, println_bool, println_i64 } from "Io.myl";

fn printError(IoError error) -> void {
    println_i64(error.code as i64);
}

fn main() -> i32 {
    string directory = "build/tests/dir_watch_api";
    string filePath = "build/tests/dir_watch_api/a.txt";
    File::RemoveDirAll(directory);
    Result<i64, IoError> made = File::MkdirAll(directory);
    match made {
        Ok(_) => { }
        Err(makeError1) => { printError(makeError1); return 1; }
    }

    Result<File, IoError> created = File::Create(filePath);
    match created {
        Ok(file) => {
            file.writeAllText("one");
            file.close();
        }
        Err(createError1) => { printError(createError1); return 1; }
    }

    Result<i32, IoError> mode = File::Mode(filePath);
    match mode {
        Ok(modeValue) => {
            println_bool((modeValue & 128) != 0);
            Result<i64, IoError> changed = File::Chmod(filePath, 256);
            match changed {
                Ok(_) => {
                    Result<i32, IoError> after = File::Mode(filePath);
                    match after {
                        Ok(newMode) => { println_bool((newMode & 128) == 0); }
                        Err(afterModeError) => { printError(afterModeError); }
                    }
                }
                Err(chmodError1) => { printError(chmodError1); }
            }
        }
        Err(outerModeError) => { printError(outerModeError); }
    }

    Result<i64, IoError> modified = File::ModifiedMillis(filePath);
    match modified {
        Ok(modifiedValue) => { println_bool(modifiedValue > 0); }
        Err(timeError1) => { printError(timeError1); }
    }

    Result<DirWatcher, IoError> watched = DirWatcher::Watch(directory);
    match watched {
        Ok(watcher) => {
            Result<i64, IoError> removed = File::Remove(filePath);
            match removed {
                Ok(_) => {
                    Result<Vec<DirEvent>, IoError> deletedEvents = watcher.poll();
                    match deletedEvents {
                        Ok(events) => {
                            println_i64(events.len() as i64);
                            if (events.len() > 0) { println_i64(events.get(0).kind as i64); }
                        }
                        Err(pollError1) => { printError(pollError1); }
                    }
                }
                Err(removeError1) => { printError(removeError1); }
            }

            Result<File, IoError> again = File::Create(filePath);
            match again {
                Ok(file) => {
                    file.writeAllText("one");
                    file.close();
                    Result<Vec<DirEvent>, IoError> createdEvents = watcher.poll();
                    match createdEvents {
                        Ok(events) => {
                            println_i64(events.len() as i64);
                            if (events.len() > 0) { println_i64(events.get(0).kind as i64); }
                        }
                        Err(pollError12) => { printError(pollError12); }
                    }

                    Result<File, IoError> appended = File::Append(filePath);
                    match appended {
                        Ok(file2) => {
                            file2.writeAllText("two-more-bytes");
                            file2.close();
                            Result<Vec<DirEvent>, IoError> changedEvents = watcher.poll();
                            match changedEvents {
                                Ok(events) => {
                                    println_i64(events.len() as i64);
                                    if (events.len() > 0) { println_i64(events.get(0).kind as i64); }
                                }
                                Err(pollError13) => { printError(pollError13); }
                            }
                        }
                        Err(appendError1) => { printError(appendError1); }
                    }
                }
                Err(createError12) => { printError(createError12); }
            }
            watcher.close();
        }
        Err(watchError1) => { printError(watchError1); }
    }

    string nested = Path::Join(directory, "sub");
    Result<i64, IoError> nestedMade = File::MkdirAll(nested);
    match nestedMade {
        Ok(_) => { }
        Err(nestedError) => { printError(nestedError); return 1; }
    }
    string nestedFile = Path::Join(nested, "seed.txt");
    Result<File, IoError> seed = File::Create(nestedFile);
    match seed {
        Ok(seedFile) => {
            seedFile.writeAllText("seed");
            seedFile.close();
        }
        Err(seedError) => { printError(seedError); return 1; }
    }

    // 非递归监听只看到根目录，不会因嵌套文件变化产生事件。
    Result<DirWatcher, IoError> shallow = DirWatcher::Watch(directory);
    match shallow {
        Ok(shallowWatcher) => {
            Result<File, IoError> appender = File::Append(nestedFile);
            match appender {
                Ok(appendFile) => {
                    appendFile.writeAllText("more");
                    appendFile.close();
                    Result<Vec<DirEvent>, IoError> nestedEvents = shallowWatcher.poll();
                    match nestedEvents {
                        Ok(events) => { println_i64(events.len() as i64); }
                        Err(nestedPollError) => { printError(nestedPollError); }
                    }
                }
                Err(appendNestedError) => { printError(appendNestedError); }
            }
            shallowWatcher.close();
        }
        Err(shallowError) => { printError(shallowError); }
    }

    // 递归监听能看到子目录里的文件修改。
    Result<DirWatcher, IoError> deep = DirWatcher::WatchRecursive(directory);
    match deep {
        Ok(deepWatcher) => {
            Result<File, IoError> appender2 = File::Append(nestedFile);
            match appender2 {
                Ok(appendFile2) => {
                    appendFile2.writeAllText("again");
                    appendFile2.close();
                    Result<Vec<DirEvent>, IoError> deepEvents = deepWatcher.poll();
                    match deepEvents {
                        Ok(events) => {
                            println_i64(events.len() as i64);
                            if (events.len() > 0) {
                                println_i64(events.get(0).kind as i64);
                                println(events.get(0).name);
                            }
                        }
                        Err(deepPollError) => { printError(deepPollError); }
                    }
                }
                Err(appender2Error) => { printError(appender2Error); }
            }
            deepWatcher.close();
        }
        Err(deepError) => { printError(deepError); }
    }

    File::RemoveDirAll(directory);
    return 0;
}
