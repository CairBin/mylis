// Unicode 文字属性与 Script / sc / Is 别名。
import { Regex } from "Regex.myl";
import { IoError } from "IoError.myl";
import { println_bool } from "Io.myl";

fn check(string pattern, string text) -> void {
    Result<Regex, IoError> result = Regex::Compile(pattern);
    match result {
        Ok(regex) => { println_bool(regex.isMatch(text)); }
        Err(_) => { println_bool(false); }
    }
}

fn main() -> i32 {
    check("\\p{{Latin}}", "A");
    check("\\p{{Latin}}", "é");
    check("\\p{{Latin}}", "Ω");
    check("\\p{{Latn}}", "é");
    check("\\p{{Script=Latin}}", "A");
    check("\\p{{sc=Latn}}", "é");
    check("\\p{{IsLatin}}", "A");
    check("\\p{{Thai}}", "ก");
    check("\\p{{Thai}}", "a");
    check("\\p{{Thai}}", "๑");
    check("\\p{{Devanagari}}", "अ");
    check("\\p{{Deva}}", "१");
    check("\\p{{Devanagari}}", "ก");
    check("\\p{{Common}}", "0");
    check("\\p{{Common}}", "!");
    check("\\p{{Common}}", "😀");
    check("\\p{{Common}}", "A");
    check("\\p{{Zyyy}}", "!");
    check("\\p{{Hani}}", "中");
    check("\\p{{Hira}}", "あ");
    check("\\p{{Kana}}", "ア");
    check("\\p{{Hang}}", "가");
    check("\\p{{Cyrl}}", "А");
    check("\\p{{Grek}}", "Ω");
    check("\\p{{Arab}}", "ا");
    check("[\\p{{Latin}}\\p{{Thai}}]", "ก");
    check("[\\p{{Latin}}\\p{{Thai}}]", "Ω");
    check("\\P{{Latin}}", "Ω");
    check("\\P{{Latin}}", "A");
    check("\\p{{Latin}}+", "abcé");
    check("\\p{{Unknown}}", "a");
    return 0;
}
