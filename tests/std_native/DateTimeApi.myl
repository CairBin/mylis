import { DateTime } from "DateTime.myl";
import { TimeZone } from "TimeZone.myl";
import { Time } from "Time.myl";
import { println, println_bool, println_i64 } from "Io.myl";

fn main() -> i32 {
    DateTime utcEpoch = DateTime::FromMillis(0);
    println(utcEpoch.toIso8601());
    println_i64(utcEpoch.weekday as i64);
    println_i64(utcEpoch.year as i64);

    DateTime utcValue = DateTime::FromMillis(1700000000000);
    println(utcValue.toIso8601());
    DateTime shanghai = utcValue.withZone(TimeZone::Fixed(480));
    println(shanghai.toIso8601());
    println(shanghai.format("EEE yyyy-MM-dd HH:mm:ss"));

    DateTime nextDay = utcValue.addDays(1);
    println(nextDay.toIso8601());
    DateTime earlier = DateTime::FromMillis(-1);
    println(earlier.toIso8601());

    Result<DateTime, string> parsed = DateTime::ParseIso8601("2024-02-29T12:34:56.789+08:00");
    match parsed {
        Ok(value) => {
            println(value.toIso8601());
            println_i64(value.timestampMillis);
            println_i64(value.offsetMinutes as i64);
        }
        Err(message) => { println(message); }
    }

    Result<DateTime, string> compact = DateTime::ParseIso8601("2024-02-29T12:34:56.78+0800");
    match compact {
        Ok(compactValue) => {
            println(compactValue.toIso8601());
            println_i64(compactValue.offsetMinutes as i64);
        }
        Err(compactMessage) => { println(compactMessage); }
    }

    Result<DateTime, string> comma = DateTime::ParseIso8601("2024-02-29T12:34:56,123456Z");
    match comma {
        Ok(commaValue) => { println(commaValue.toIso8601()); }
        Err(commaMessage) => { println(commaMessage); }
    }

    Result<DateTime, string> shortOffset = DateTime::ParseIso8601("2024-02-29T12:34:56+08");
    match shortOffset {
        Ok(shortValue) => {
            println(shortValue.toIso8601());
            println_i64(shortValue.offsetMinutes as i64);
        }
        Err(shortMessage) => { println(shortMessage); }
    }

    Result<DateTime, string> tooMany = DateTime::ParseIso8601("2024-02-29T12:34:56.1234567890Z");
    match tooMany {
        Ok(_) => { println("bad-fraction-accepted"); }
        Err(_) => { println("bad-fraction-error"); }
    }

    Result<DateTime, string> badOffset = DateTime::ParseIso8601("2024-02-29T12:34:56+8");
    match badOffset {
        Ok(_) => { println("bad-offset-accepted"); }
        Err(_) => { println("bad-offset-error"); }
    }

    i64 offset = Time::LocalOffsetMinutes();
    println_bool(offset >= -720 && offset <= 840);
    return 0;
}
