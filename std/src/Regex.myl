// 纯 Mylis 正则：支持字面量、`.`、`^`/`$`、字符类、`\d/\w/\s`、`\b/\B`、
// 内联选项 `(?i)` / `(?s)` / `(?m)`（含作用域形式 `(?i:...)`）、捕获组、
// 非捕获组 `(?:...)`、命名组 `(?<name>...)` / `(?P<name>...)`、
// 先行/后行断言 `(?=...)` / `(?!...)` / `(?<=...)` / `(?<!...)`、
// 反向引用 `\1`..`\99` / `\k<name>` / `(?P=name)`、Unicode 字符类
// `\p{...}` / `\P{...}`、`(?u)` 码点模式与 `(?iu)` 简单大小写折叠、分支 `|`、
// `* + ?` 与 `{m,n}` 计数量词。
// 匹配结果是字节偏移。find/findAll 默认走 Thompson NFA；含断言、反向引用或
// findCaptures 时走回溯，findCaptures 采用左优先贪婪语义。
import { Str } from "core/Str";
import { StringBuilder } from "StringBuilder.myl";
import { IoError } from "IoError.myl";
import { Vec } from "Vec.myl";
import { RegexMatch } from "RegexMatch.myl";
import { RegexCaptures } from "RegexCaptures.myl";
import { UnicodeData } from "UnicodeData.myl";

class RegexClass {
    bool negated;
    bool unicode;
    i32[] ranges;
    i32 count;

    pub fn init(bool invert) -> void {
        this.negated = invert;
        this.unicode = false;
        this.ranges = new i32[16];
        this.count = 0;
    }

    fn addRange(i32 first, i32 last) -> void {
        if (this.count + 2 > this.ranges.len() as i32) {
            i32[] grown = new i32[(this.ranges.len() as i32) * 2];
            i32 i = 0;
            while (i < this.count) {
                grown[i] = this.ranges[i];
                i = i + 1;
            }
            this.ranges = grown;
        }
        this.ranges[this.count] = first;
        this.ranges[this.count + 1] = last;
        this.count = this.count + 2;
    }

    fn addDigit() -> void {
        this.addRange(48, 57);
    }

    fn addWord() -> void {
        this.addRange(48, 57);
        this.addRange(65, 90);
        this.addRange(97, 122);
        this.addRange(95, 95);
    }

    fn addSpace() -> void {
        this.addRange(9, 13);
        this.addRange(32, 32);
    }

    fn contains(i32 code) -> bool {
        i32 i = 0;
        while (i < this.count) {
            if (code >= this.ranges[i] && code <= this.ranges[i + 1]) {
                return true;
            }
            i = i + 2;
        }
        return false;
    }

    fn matchesCode(i32 value) -> bool {
        bool hit = this.contains(value);
        if (this.negated) { return !hit; }
        return hit;
    }

    fn matchesFold(u8 value, bool ignoreCase) -> bool {
        i32 code = value as i32;
        bool hit = this.contains(code);
        if (ignoreCase && !hit) {
            if (code >= 65 && code <= 90) {
                hit = this.contains(code + 32);
            } else if (code >= 97 && code <= 122) {
                hit = this.contains(code - 32);
            }
        }
        if (this.negated) {
            return !hit;
        }
        return hit;
    }
}

class RegexState {
    pub static const i32 CHAR = 1;
    pub static const i32 ANY = 2;
    pub static const i32 CLASS = 3;
    pub static const i32 SPLIT = 4;
    pub static const i32 MATCH = 5;
    pub static const i32 BOL = 6;
    pub static const i32 EOL = 7;
    pub static const i32 EPS = 8;
    pub static const i32 SAVE = 9;
    pub static const i32 LOOK = 10;
    pub static const i32 ASSERT_MATCH = 11;
    pub static const i32 BACKREF = 12;
    pub static const i32 BOUNDARY = 13;
    pub static const i32 CODEPOINT = 14;
    pub static const i32 CLASS_CODE = 15;
    pub static const i32 LOOK_NEGATIVE = 1;
    pub static const i32 BOUNDARY_NEGATIVE = 1;
    pub static const i32 BOUNDARY_UNICODE = 2;
    pub static const i32 STATE_FLAG = 256;
    pub static const i32 BACKREF_UNICODE = 512;
    pub static const i32 MULTILINE = 1;
    pub static const i32 LOOK_BEHIND = 2;

    i32 op;
    i32 out1;
    i32 out2;
    i32 ch;
    RegexClass cls;

    pub fn init(i32 operation, i32 value, RegexClass characterClass) -> void {
        this.op = operation;
        this.out1 = -1;
        this.out2 = -1;
        this.ch = value;
        this.cls = characterClass;
    }
}

class RegexFrag {
    i32 start;
    i32[] outs;
    i32 count;

    pub fn init(i32 value) -> void {
        this.start = value;
        this.outs = new i32[8];
        this.count = 0;
    }

    fn addOut(i32 slot) -> void {
        if (this.count + 1 > this.outs.len() as i32) {
            i32[] grown = new i32[(this.outs.len() as i32) * 2];
            i32 i = 0;
            while (i < this.count) {
                grown[i] = this.outs[i];
                i = i + 1;
            }
            this.outs = grown;
        }
        this.outs[this.count] = slot;
        this.count = this.count + 1;
    }

    fn absorb(RegexFrag other) -> void {
        i32 i = 0;
        while (i < other.count) {
            this.addOut(other.outs[i]);
            i = i + 1;
        }
    }
}

class RegexCompiler {
    string pattern;
    u8[] bytes;
    i32 pos;
    RegexState[] states;
    i32 stateCount;
    i32 stateCapacity;
    bool failed;
    i32 groupCount;
    bool hasLookahead;
    bool hasBackref;
    bool hasUnicode;
    bool ignoreCase;
    bool dotAll;
    bool multiline;
    bool wordUnicode;
    string[] groupNames;

    pub fn init(string source) -> void {
        this.pattern = source;
        this.bytes = Str::Bytes(source);
        this.pos = 0;
        this.stateCapacity = 32;
        this.states = new RegexState[this.stateCapacity];
        this.stateCount = 0;
        this.failed = false;
        this.groupCount = 1;
        this.hasLookahead = false;
        this.hasBackref = false;
        this.hasUnicode = false;
        this.ignoreCase = false;
        this.dotAll = false;
        this.multiline = false;
        this.wordUnicode = false;
        this.groupNames = new string[32];
        i32 i = 0;
        while (i < 32) {
            this.groupNames[i] = "";
            i = i + 1;
        }
    }

    fn fail() -> RegexFrag {
        this.failed = true;
        this.pos = this.bytes.len() as i32;
        return this.emptyFrag();
    }

    fn grow() -> void {
        this.stateCapacity = this.stateCapacity * 2;
        RegexState[] next = new RegexState[this.stateCapacity];
        i32 i = 0;
        while (i < this.stateCount) {
            next[i] = this.states[i];
            i = i + 1;
        }
        this.states = next;
    }

    fn addState(i32 op, i32 ch, RegexClass cls) -> i32 {
        if (this.stateCount >= this.stateCapacity) {
            this.grow();
        }
        i32 index = this.stateCount;
        this.states[index] = new RegexState(op, ch, cls);
        this.stateCount = this.stateCount + 1;
        return index;
    }

    fn patch(RegexFrag frag, i32 target) -> void {
        i32 i = 0;
        while (i < frag.count) {
            i32 slot = frag.outs[i];
            i32 stateIndex = slot / 2;
            if (slot % 2 == 0) {
                this.states[stateIndex].out1 = target;
            } else {
                this.states[stateIndex].out2 = target;
            }
            i = i + 1;
        }
    }

    fn emptyFrag() -> RegexFrag {
        RegexClass dummy = new RegexClass(false);
        i32 index = this.addState(RegexState::EPS, 0, dummy);
        RegexFrag frag = new RegexFrag(index);
        frag.addOut(index * 2);
        return frag;
    }

    fn saveGroup(RegexFrag body, i32 group) -> RegexFrag {
        if (body.start < 0) { body = this.emptyFrag(); }
        RegexClass dummy = new RegexClass(false);
        i32 startState = this.addState(RegexState::SAVE, group * 2, dummy);
        i32 endState = this.addState(RegexState::SAVE, group * 2 + 1, dummy);
        this.states[startState].out1 = body.start;
        this.patch(body, endState);
        RegexFrag result = new RegexFrag(startState);
        result.addOut(endState * 2);
        return result;
    }

    fn lookaroundFrag(RegexFrag body, bool negative, bool behind) -> RegexFrag {
        RegexClass dummy = new RegexClass(false);
        i32 endpoint = this.addState(RegexState::ASSERT_MATCH, 0, dummy);
        this.patch(body, endpoint);
        i32 kind = 0;
        if (negative) { kind = kind | RegexState::LOOK_NEGATIVE; }
        if (behind) { kind = kind | RegexState::LOOK_BEHIND; }
        i32 look = this.addState(RegexState::LOOK, kind, dummy);
        this.states[look].out2 = body.start;
        RegexFrag result = new RegexFrag(look);
        result.addOut(look * 2);
        this.hasLookahead = true;
        return result;
    }

    fn backrefFrag(i32 group) -> RegexFrag {
        RegexClass dummy = new RegexClass(false);
        i32 encoded = group;
        if (this.ignoreCase) { encoded = encoded | RegexState::STATE_FLAG; }
        if (this.wordUnicode && this.ignoreCase) { encoded = encoded | RegexState::BACKREF_UNICODE; }
        i32 state = this.addState(RegexState::BACKREF, encoded, dummy);
        RegexFrag result = new RegexFrag(state);
        result.addOut(state * 2);
        this.hasBackref = true;
        return result;
    }

    fn concat(RegexFrag left, RegexFrag right) -> RegexFrag {
        if (left.start < 0) { return right; }
        if (right.start < 0) { return left; }
        this.patch(left, right.start);
        RegexFrag result = new RegexFrag(left.start);
        result.absorb(right);
        return result;
    }

    fn alternation(RegexFrag left, RegexFrag right) -> RegexFrag {
        if (left.start < 0) { return right; }
        if (right.start < 0) { return left; }
        RegexClass dummy = new RegexClass(false);
        i32 split = this.addState(RegexState::SPLIT, 0, dummy);
        this.states[split].out1 = left.start;
        this.states[split].out2 = right.start;
        RegexFrag result = new RegexFrag(split);
        result.absorb(left);
        result.absorb(right);
        return result;
    }

    fn star(RegexFrag body) -> RegexFrag {
        RegexClass dummy = new RegexClass(false);
        i32 split = this.addState(RegexState::SPLIT, 0, dummy);
        this.states[split].out1 = body.start;
        this.patch(body, split);
        RegexFrag result = new RegexFrag(split);
        result.addOut(split * 2 + 1);
        return result;
    }

    fn plus(RegexFrag body) -> RegexFrag {
        RegexClass dummy = new RegexClass(false);
        i32 split = this.addState(RegexState::SPLIT, 0, dummy);
        this.states[split].out1 = body.start;
        this.patch(body, split);
        RegexFrag result = new RegexFrag(body.start);
        result.addOut(split * 2 + 1);
        return result;
    }

    fn question(RegexFrag body) -> RegexFrag {
        RegexClass dummy = new RegexClass(false);
        i32 split = this.addState(RegexState::SPLIT, 0, dummy);
        this.states[split].out1 = body.start;
        RegexFrag result = new RegexFrag(split);
        result.absorb(body);
        result.addOut(split * 2 + 1);
        return result;
    }

    fn currentByte() -> u8 {
        if (this.pos >= this.bytes.len() as i32) { return 0; }
        return this.bytes[this.pos];
    }

    fn atEnd() -> bool {
        return this.pos >= this.bytes.len() as i32;
    }

    fn addCaseVariants(RegexClass cls) -> void {
        i32[] pairs = UnicodeData::CasePairs();
        bool changed = true;
        while (changed) {
            changed = false;
            i32 i = 0;
            while (i + 1 < pairs.len() as i32) {
                i32 left = pairs[i];
                i32 right = pairs[i + 1];
                bool hasLeft = cls.contains(left);
                bool hasRight = cls.contains(right);
                if (hasLeft && !hasRight) {
                    cls.addRange(right, right);
                    changed = true;
                }
                if (hasRight && !hasLeft) {
                    cls.addRange(left, left);
                    changed = true;
                }
                i = i + 2;
            }
        }
    }

    fn literalCodeFrag(i32 code) -> RegexFrag {
        RegexClass cls = new RegexClass(false);
        cls.unicode = true;
        cls.addRange(code, code);
        this.addCaseVariants(cls);
        this.hasUnicode = true;
        return this.classFrag(cls);
    }

    fn literalFrag(u8 value) -> RegexFrag {
        if (this.wordUnicode && this.ignoreCase) {
            return this.literalCodeFrag(value as i32);
        }
        RegexClass dummy = new RegexClass(false);
        i32 encoded = value as i32;
        if (this.ignoreCase) { encoded = encoded | RegexState::STATE_FLAG; }
        i32 index = this.addState(RegexState::CHAR, encoded, dummy);
        RegexFrag frag = new RegexFrag(index);
        frag.addOut(index * 2);
        return frag;
    }

    fn classFrag(RegexClass cls) -> RegexFrag {
        i32 flags = 0;
        if (this.ignoreCase) { flags = RegexState::STATE_FLAG; }
        i32 op = RegexState::CLASS;
        if (cls.unicode) {
            op = RegexState::CLASS_CODE;
            flags = 0;
            this.hasUnicode = true;
        }
        i32 index = this.addState(op, flags, cls);
        RegexFrag frag = new RegexFrag(index);
        frag.addOut(index * 2);
        return frag;
    }

    fn codePointFrag(RegexClass cls) -> RegexFrag {
        i32 index = this.addState(RegexState::CODEPOINT, 0, cls);
        RegexFrag frag = new RegexFrag(index);
        frag.addOut(index * 2);
        this.hasUnicode = true;
        return frag;
    }

    fn appendRanges(RegexClass cls, i32[] ranges) -> void {
        i32 i = 0;
        while (i < ranges.len() as i32) {
            cls.addRange(ranges[i], ranges[i + 1]);
            i = i + 2;
        }
    }

    fn wordRanges(bool unicode) -> i32[] {
        if (!unicode) {
            return [48, 57, 65, 90, 97, 122, 95, 95];
        }
        i32[] letters = UnicodeData::Ranges("L");
        i32[] digits = UnicodeData::Ranges("Nd");
        i32[] out = new i32[(letters.len() + digits.len() + 2) as u64];
        i32 i = 0;
        while (i < letters.len() as i32) {
            out[i] = letters[i];
            i = i + 1;
        }
        i32 at = letters.len() as i32;
        i = 0;
        while (i < digits.len() as i32) {
            out[at] = digits[i];
            at = at + 1;
            i = i + 1;
        }
        out[at] = 95;
        out[at + 1] = 95;
        return out;
    }

    fn digitRanges(bool unicode) -> i32[] {
        if (!unicode) { return [48, 57]; }
        return UnicodeData::Ranges("Nd");
    }

    fn spaceRanges(bool unicode) -> i32[] {
        if (!unicode) { return [9, 13, 32, 32]; }
        i32[] separators = UnicodeData::Ranges("Z");
        i32[] out = new i32[(separators.len() + 6) as u64];
        i32 i = 0;
        while (i < separators.len() as i32) {
            out[i] = separators[i];
            i = i + 1;
        }
        i32 at = separators.len() as i32;
        out[at] = 9;
        out[at + 1] = 13;
        out[at + 2] = 32;
        out[at + 3] = 32;
        out[at + 4] = 133;
        out[at + 5] = 133;
        return out;
    }

    fn wordClass(bool invert) -> RegexClass {
        RegexClass cls = new RegexClass(invert);
        this.appendRanges(cls, this.wordRanges(this.wordUnicode));
        cls.unicode = this.wordUnicode;
        return cls;
    }

    fn digitClass(bool invert) -> RegexClass {
        RegexClass cls = new RegexClass(invert);
        this.appendRanges(cls, this.digitRanges(this.wordUnicode));
        cls.unicode = this.wordUnicode;
        return cls;
    }

    fn spaceClass(bool invert) -> RegexClass {
        RegexClass cls = new RegexClass(invert);
        this.appendRanges(cls, this.spaceRanges(this.wordUnicode));
        cls.unicode = this.wordUnicode;
        return cls;
    }

    fn anyFrag() -> RegexFrag {
        RegexClass dummy = new RegexClass(false);
        i32 flags = 0;
        if (this.dotAll) { flags = RegexState::STATE_FLAG; }
        i32 index = this.addState(RegexState::ANY, flags, dummy);
        RegexFrag frag = new RegexFrag(index);
        frag.addOut(index * 2);
        return frag;
    }

    fn anchorFrag(i32 op, i32 flags) -> RegexFrag {
        RegexClass dummy = new RegexClass(false);
        i32 index = this.addState(op, flags, dummy);
        RegexFrag frag = new RegexFrag(index);
        frag.addOut(index * 2);
        return frag;
    }

    fn boundaryFrag(i32 flags) -> RegexFrag {
        RegexClass dummy = new RegexClass(false);
        if (this.wordUnicode) {
            dummy = this.wordClass(false);
            flags = flags | RegexState::BOUNDARY_UNICODE;
        }
        i32 index = this.addState(RegexState::BOUNDARY, flags, dummy);
        RegexFrag frag = new RegexFrag(index);
        frag.addOut(index * 2);
        return frag;
    }

    fn collectState(i32 index, bool[] seen, i32[] order, i32[] count) -> void {
        if (index < 0 || index >= this.stateCount || seen[index]) {
            return;
        }
        seen[index] = true;
        order[count[0]] = index;
        count[0] = count[0] + 1;
        i32 op = this.states[index].op;
        if (op == RegexState::SPLIT) {
            this.collectState(this.states[index].out1, seen, order, count);
            this.collectState(this.states[index].out2, seen, order, count);
        } else {
            this.collectState(this.states[index].out1, seen, order, count);
        }
    }

    fn cloneFrag(RegexFrag body) -> RegexFrag {
        if (body.start < 0) { return body; }
        bool[] seen = new bool[this.stateCount];
        i32[] order = new i32[this.stateCount];
        i32[] count = new i32[1];
        count[0] = 0;
        this.collectState(body.start, seen, order, count);
        i32[] map = new i32[this.stateCount];
        i32 i = 0;
        while (i < this.stateCount) {
            map[i] = -1;
            i = i + 1;
        }
        i = 0;
        while (i < count[0]) {
            i32 oldIndex = order[i];
            RegexClass cls = this.states[oldIndex].cls;
            i32 newIndex = this.addState(this.states[oldIndex].op, this.states[oldIndex].ch, cls);
            map[oldIndex] = newIndex;
            i = i + 1;
        }
        i = 0;
        while (i < count[0]) {
            i32 oldIndex = order[i];
            i32 newIndex = map[oldIndex];
            i32 oldOut1 = this.states[oldIndex].out1;
            i32 oldOut2 = this.states[oldIndex].out2;
            if (oldOut1 >= 0 && map[oldOut1] >= 0) {
                this.states[newIndex].out1 = map[oldOut1];
            }
            if (oldOut2 >= 0 && map[oldOut2] >= 0) {
                this.states[newIndex].out2 = map[oldOut2];
            }
            i = i + 1;
        }
        RegexFrag result = new RegexFrag(map[body.start]);
        i = 0;
        while (i < body.count) {
            i32 slot = body.outs[i];
            i32 oldState = slot / 2;
            i32 mappedState = map[oldState];
            if (mappedState >= 0) {
                result.addOut(mappedState * 2 + (slot % 2));
            }
            i = i + 1;
        }
        return result;
    }

    fn repeatFrag(RegexFrag body, i32 minimum, i32 maximum) -> RegexFrag {
        RegexFrag result = new RegexFrag(-1);
        i32 i = 0;
        while (i < minimum) {
            result = this.concat(result, this.cloneFrag(body));
            i = i + 1;
        }
        if (maximum < 0) {
            result = this.concat(result, this.star(this.cloneFrag(body)));
        } else {
            i = minimum;
            while (i < maximum) {
                result = this.concat(result, this.question(this.cloneFrag(body)));
                i = i + 1;
            }
        }
        return result;
    }

    fn parseAlternation() -> RegexFrag {
        RegexFrag result = this.parseSequence();
        while (!this.atEnd() && this.currentByte() == 124) {
            this.pos = this.pos + 1;
            RegexFrag right = this.parseSequence();
            result = this.alternation(result, right);
        }
        return result;
    }

    fn parseSequence() -> RegexFrag {
        RegexFrag result = new RegexFrag(-1);
        while (!this.atEnd() && this.currentByte() != 124 && this.currentByte() != 41) {
            RegexFrag part = this.parseQuantified();
            result = this.concat(result, part);
        }
        return result;
    }

    fn parseQuantified() -> RegexFrag {
        RegexFrag atom = this.parseAtom();
        if (!this.atEnd()) {
            u8 next = this.currentByte();
            if (next == 42) {
                this.pos = this.pos + 1;
                atom = this.star(atom);
            } else if (next == 43) {
                this.pos = this.pos + 1;
                atom = this.plus(atom);
            } else if (next == 63) {
                this.pos = this.pos + 1;
                atom = this.question(atom);
            } else if (next == 123) {
                this.pos = this.pos + 1;
                i32 minimum = 0;
                bool hasDigits = false;
                while (!this.atEnd() && this.currentByte() >= 48 && this.currentByte() <= 57) {
                    minimum = minimum * 10 + ((this.currentByte() - 48) as i32);
                    hasDigits = true;
                    this.pos = this.pos + 1;
                }
                i32 maximum = minimum;
                if (!this.atEnd() && this.currentByte() == 44) {
                    this.pos = this.pos + 1;
                    if (!this.atEnd() && this.currentByte() >= 48 && this.currentByte() <= 57) {
                        maximum = 0;
                        while (!this.atEnd() && this.currentByte() >= 48 && this.currentByte() <= 57) {
                            maximum = maximum * 10 + ((this.currentByte() - 48) as i32);
                            this.pos = this.pos + 1;
                        }
                    } else {
                        maximum = -1;
                    }
                }
                if (!this.atEnd() && this.currentByte() == 125) {
                    this.pos = this.pos + 1;
                } else {
                    return this.fail();
                }
                if (!hasDigits || minimum > 1000 || (maximum >= 0 && maximum < minimum) || maximum > 1000) {
                    return this.fail();
                }
                atom = this.repeatFrag(atom, minimum, maximum);
            }
            if (!this.atEnd() && (this.currentByte() == 42 || this.currentByte() == 43 || this.currentByte() == 63)) {
                return this.fail();
            }
        }
        return atom;
    }

    fn ensureGroupNames(i32 needed) -> void {
        if (needed <= this.groupNames.len() as i32) { return; }
        i32 capacity = this.groupNames.len() as i32;
        while (capacity < needed) { capacity = capacity * 2; }
        string[] grown = new string[capacity];
        i32 i = 0;
        while (i < capacity) {
            if (i < this.groupNames.len() as i32) {
                grown[i] = this.groupNames[i];
            } else {
                grown[i] = "";
            }
            i = i + 1;
        }
        this.groupNames = grown;
    }

    fn recordGroupName(i32 group, string name) -> bool {
        if (group < 1 || name == "") { return false; }
        this.ensureGroupNames(group + 1);
        i32 i = 1;
        while (i < group) {
            if (this.groupNames[i] == name) { return false; }
            i = i + 1;
        }
        this.groupNames[group] = name;
        return true;
    }

    fn findGroupName(string name) -> i32 {
        i32 i = 1;
        while (i < this.groupCount) {
            if (this.groupNames[i] == name) { return i; }
            i = i + 1;
        }
        return -1;
    }

    fn slicePattern(i32 start, i32 length) -> string {
        if (start < 0 || length <= 0 || start + length > this.bytes.len() as i32) { return ""; }
        u8[] part = new u8[length as u64];
        i32 i = 0;
        while (i < length) {
            part[i] = this.bytes[start + i];
            i = i + 1;
        }
        return Str::FromBytes(part);
    }

    fn parseGroupName() -> string {
        i32 start = this.pos;
        if (this.atEnd()) { return ""; }
        u8 first = this.currentByte();
        bool valid = (first >= 65 && first <= 90) || (first >= 97 && first <= 122) || first == 95;
        if (!valid) { return ""; }
        this.pos = this.pos + 1;
        while (!this.atEnd()) {
            u8 c = this.currentByte();
            bool part = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95;
            if (!part) { break; }
            this.pos = this.pos + 1;
        }
        if (this.atEnd() || this.currentByte() != 62) { return ""; }
        i32 length = this.pos - start;
        if (length <= 0 || length > 64) { return ""; }
        this.pos = this.pos + 1;
        return this.slicePattern(start, length);
    }

    fn parseGroupRefName() -> string {
        i32 start = this.pos;
        if (this.atEnd()) { return ""; }
        u8 first = this.currentByte();
        bool valid = (first >= 65 && first <= 90) || (first >= 97 && first <= 122) || first == 95;
        if (!valid) { return ""; }
        this.pos = this.pos + 1;
        while (!this.atEnd() && this.currentByte() != 41) {
            u8 c = this.currentByte();
            bool part = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95;
            if (!part) { break; }
            this.pos = this.pos + 1;
        }
        if (this.atEnd() || this.currentByte() != 41) { return ""; }
        i32 length = this.pos - start;
        if (length <= 0 || length > 64) { return ""; }
        this.pos = this.pos + 1;
        return this.slicePattern(start, length);
    }

    fn parsePropertyName() -> string {
        i32 start = this.pos;
        while (!this.atEnd() && this.currentByte() != 125) {
            u8 c = this.currentByte();
            bool part = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95;
            if (!part) { return ""; }
            this.pos = this.pos + 1;
        }
        if (this.atEnd() || this.currentByte() != 125) { return ""; }
        i32 length = this.pos - start;
        if (length <= 0 || length > 64) { return ""; }
        this.pos = this.pos + 1;
        return this.slicePattern(start, length);
    }

    fn normalizePropertyName(string name) -> string {
        if (name == "Letter") { return "L"; }
        if (name == "Number") { return "N"; }
        if (name == "Decimal_Number") { return "Nd"; }
        if (name == "Punctuation") { return "P"; }
        if (name == "Separator") { return "Z"; }
        if (name == "Symbol") { return "S"; }
        if (name == "Mark") { return "M"; }
        return name;
    }

    fn parseInlineFlags() -> RegexFrag {
        bool negative = false;
        bool any = false;
        bool oldIgnoreCase = this.ignoreCase;
        bool oldDotAll = this.dotAll;
        bool oldMultiline = this.multiline;
        bool oldWordUnicode = this.wordUnicode;
        while (!this.atEnd()) {
            u8 c = this.currentByte();
            if (c == 45) {
                negative = true;
                this.pos = this.pos + 1;
                continue;
            }
            if (c == 105) {
                this.ignoreCase = !negative;
                any = true;
                this.pos = this.pos + 1;
                continue;
            }
            if (c == 115) {
                this.dotAll = !negative;
                any = true;
                this.pos = this.pos + 1;
                continue;
            }
            if (c == 109) {
                this.multiline = !negative;
                any = true;
                this.pos = this.pos + 1;
                continue;
            }
            if (c == 117) {
                this.wordUnicode = !negative;
                any = true;
                this.pos = this.pos + 1;
                continue;
            }
            if (c == 41) {
                this.pos = this.pos + 1;
                if (!any) { return this.fail(); }
                return this.emptyFrag();
            }
            if (c == 58) {
                this.pos = this.pos + 1;
                if (!any) { return this.fail(); }
                RegexFrag inner = this.parseAlternation();
                if (this.atEnd() || this.currentByte() != 41) { return this.fail(); }
                this.pos = this.pos + 1;
                this.ignoreCase = oldIgnoreCase;
                this.dotAll = oldDotAll;
                this.multiline = oldMultiline;
                this.wordUnicode = oldWordUnicode;
                return inner;
            }
            return this.fail();
        }
        return this.fail();
    }

    fn parseAtom() -> RegexFrag {
        if (this.atEnd()) {
            return this.emptyFrag();
        }
        u8 c = this.currentByte();
        if (c == 40) {
            this.pos = this.pos + 1;
            i32 mode = 0;
            string groupName = "";
            if (!this.atEnd() && this.currentByte() == 63) {
                this.pos = this.pos + 1;
                if (!this.atEnd() && (this.currentByte() == 105 || this.currentByte() == 115 || this.currentByte() == 109 || this.currentByte() == 117 || this.currentByte() == 45)) {
                    return this.parseInlineFlags();
                }
                if (!this.atEnd() && this.currentByte() == 58) {
                    mode = 1;
                    this.pos = this.pos + 1;
                } else if (!this.atEnd() && this.currentByte() == 61) {
                    mode = 2;
                    this.pos = this.pos + 1;
                } else if (!this.atEnd() && this.currentByte() == 33) {
                    mode = 3;
                    this.pos = this.pos + 1;
                } else if (!this.atEnd() && this.currentByte() == 60) {
                    this.pos = this.pos + 1;
                    if (!this.atEnd() && this.currentByte() == 61) {
                        mode = 4;
                        this.pos = this.pos + 1;
                    } else if (!this.atEnd() && this.currentByte() == 33) {
                        mode = 5;
                        this.pos = this.pos + 1;
                    } else {
                        groupName = this.parseGroupName();
                        if (groupName == "") { return this.fail(); }
                        mode = 6;
                    }
                } else if (!this.atEnd() && this.currentByte() == 80) {
                    this.pos = this.pos + 1;
                    if (this.atEnd()) { return this.fail(); }
                    if (this.currentByte() == 61) {
                        this.pos = this.pos + 1;
                        string reference = this.parseGroupRefName();
                        if (reference == "") { return this.fail(); }
                        i32 target = this.findGroupName(reference);
                        if (target < 1) { return this.fail(); }
                        return this.backrefFrag(target);
                    }
                    if (this.currentByte() != 60) { return this.fail(); }
                    this.pos = this.pos + 1;
                    groupName = this.parseGroupName();
                    if (groupName == "") { return this.fail(); }
                    mode = 6;
                } else {
                    return this.fail();
                }
            }
            bool capture = mode == 0 || mode == 6;
            i32 group = 0;
            if (capture) {
                group = this.groupCount;
                this.groupCount = this.groupCount + 1;
                if (mode == 6 && !this.recordGroupName(group, groupName)) {
                    return this.fail();
                }
            }
            RegexFrag inner = this.parseAlternation();
            if (this.atEnd() || this.currentByte() != 41) {
                return this.fail();
            }
            this.pos = this.pos + 1;
            if (mode == 2) {
                return this.lookaroundFrag(inner, false, false);
            }
            if (mode == 3) {
                return this.lookaroundFrag(inner, true, false);
            }
            if (mode == 4) {
                return this.lookaroundFrag(inner, false, true);
            }
            if (mode == 5) {
                return this.lookaroundFrag(inner, true, true);
            }
            if (capture) {
                return this.saveGroup(inner, group);
            }
            return inner;
        }
        if (c == 91) {
            return this.parseClass();
        }
        if (c == 46) {
            this.pos = this.pos + 1;
            return this.anyFrag();
        }
        if (c == 94) {
            this.pos = this.pos + 1;
            i32 flags = 0;
            if (this.multiline) { flags = RegexState::MULTILINE; }
            return this.anchorFrag(RegexState::BOL, flags);
        }
        if (c == 36) {
            this.pos = this.pos + 1;
            i32 flags = 0;
            if (this.multiline) { flags = RegexState::MULTILINE; }
            return this.anchorFrag(RegexState::EOL, flags);
        }
        if (c == 92) {
            this.pos = this.pos + 1;
            if (this.atEnd()) {
                return this.fail();
            }
            u8 escaped = this.currentByte();
            this.pos = this.pos + 1;
            if (escaped == 107) {
                if (this.atEnd() || this.currentByte() != 60) { return this.fail(); }
                this.pos = this.pos + 1;
                string name = this.parseGroupName();
                if (name == "") { return this.fail(); }
                i32 group = this.findGroupName(name);
                if (group < 1) { return this.fail(); }
                return this.backrefFrag(group);
            }
            if (escaped >= 49 && escaped <= 57) {
                i32 group = (escaped - 48) as i32;
                if (!this.atEnd()) {
                    u8 second = this.currentByte();
                    if (second >= 48 && second <= 57) {
                        i32 candidate = group * 10 + (second as i32 - 48);
                        if (candidate < this.groupCount) {
                            group = candidate;
                            this.pos = this.pos + 1;
                        }
                    }
                }
                if (group >= this.groupCount) {
                    return this.fail();
                }
                return this.backrefFrag(group);
            }
            if (escaped == 98) {
                return this.boundaryFrag(0);
            }
            if (escaped == 66) {
                return this.boundaryFrag(RegexState::BOUNDARY_NEGATIVE);
            }
            if (escaped == 112 || escaped == 80) {
                if (this.atEnd() || this.currentByte() != 123) { return this.fail(); }
                this.pos = this.pos + 1;
                string property = this.parsePropertyName();
                if (property == "") { return this.fail(); }
                property = this.normalizePropertyName(property);
                i32[] ranges = UnicodeData::Ranges(property);
                if (ranges.len() == 0) { return this.fail(); }
                RegexClass cls = new RegexClass(escaped == 80);
                i32 i = 0;
                while (i < ranges.len() as i32) {
                    cls.addRange(ranges[i], ranges[i + 1]);
                    i = i + 2;
                }
                return this.codePointFrag(cls);
            }
            if (escaped == 100) { return this.classFrag(this.digitClass(false)); }
            if (escaped == 68) { return this.classFrag(this.digitClass(true)); }
            if (escaped == 119) { return this.classFrag(this.wordClass(false)); }
            if (escaped == 87) { return this.classFrag(this.wordClass(true)); }
            if (escaped == 115) { return this.classFrag(this.spaceClass(false)); }
            if (escaped == 83) { return this.classFrag(this.spaceClass(true)); }
            u8 literal = escaped;
            if (escaped == 110) { literal = 10; }
            if (escaped == 114) { literal = 13; }
            if (escaped == 116) { literal = 9; }
            return this.literalFrag(literal);
        }
        if (c == 41 || c == 124 || c == 42 || c == 43 || c == 63 || c == 123) {
            return this.fail();
        }
        if (c >= 128 && this.wordUnicode && this.ignoreCase) {
            i32[] code = new i32[1];
            i32 step = this.decodePatternCode(this.pos, code);
            if (step < 0) { return this.fail(); }
            this.pos = this.pos + step;
            return this.literalCodeFrag(code[0]);
        }
        this.pos = this.pos + 1;
        return this.literalFrag(c);
    }

    fn decodePatternCode(i32 at, i32[] out) -> i32 {
        i32 length = this.bytes.len() as i32;
        if (at < 0 || at >= length) { return -1; }
        i32 b0 = this.bytes[at] as i32;
        if (b0 < 128) { out[0] = b0; return 1; }
        if (b0 < 192) { return -1; }
        if (b0 < 224) {
            if (at + 1 >= length) { return -1; }
            i32 b1 = this.bytes[at + 1] as i32;
            if ((b1 & 192) != 128) { return -1; }
            i32 code = ((b0 & 31) << 6) | (b1 & 63);
            if (code < 128) { return -1; }
            out[0] = code;
            return 2;
        }
        if (b0 < 240) {
            if (at + 2 >= length) { return -1; }
            i32 b1 = this.bytes[at + 1] as i32;
            i32 b2 = this.bytes[at + 2] as i32;
            if ((b1 & 192) != 128 || (b2 & 192) != 128) { return -1; }
            i32 code = ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63);
            if (code < 2048 || (code >= 55296 && code <= 57343)) { return -1; }
            out[0] = code;
            return 3;
        }
        if (b0 < 248) {
            if (at + 3 >= length) { return -1; }
            i32 b1 = this.bytes[at + 1] as i32;
            i32 b2 = this.bytes[at + 2] as i32;
            i32 b3 = this.bytes[at + 3] as i32;
            if ((b1 & 192) != 128 || (b2 & 192) != 128 || (b3 & 192) != 128) { return -1; }
            i32 code = ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63);
            if (code < 65536 || code > 1114111) { return -1; }
            out[0] = code;
            return 4;
        }
        return -1;
    }

    fn escapeValue() -> u8 {
        if (this.pos + 1 >= this.bytes.len() as i32) {
            this.pos = this.bytes.len() as i32;
            return 0;
        }
        this.pos = this.pos + 1;
        u8 value = this.bytes[this.pos];
        this.pos = this.pos + 1;
        if (value == 110) { return 10; }
        if (value == 114) { return 13; }
        if (value == 116) { return 9; }
        return value;
    }

    fn parseClass() -> RegexFrag {
        this.pos = this.pos + 1;
        bool negated = false;
        if (!this.atEnd() && this.currentByte() == 94) {
            negated = true;
            this.pos = this.pos + 1;
        }
        RegexClass cls = new RegexClass(negated);
        bool codeMode = this.wordUnicode;
        if (codeMode) {
            cls.unicode = true;
            this.hasUnicode = true;
        }
        while (!this.atEnd() && this.currentByte() != 93) {
            i32 first = 0;
            if (this.currentByte() == 92) {
                this.pos = this.pos + 1;
                if (this.atEnd()) { break; }
                u8 special = this.currentByte();
                this.pos = this.pos + 1;
                if (special == 112 || special == 80) {
                    if (this.atEnd() || this.currentByte() != 123) { return this.fail(); }
                    this.pos = this.pos + 1;
                    string property = this.parsePropertyName();
                    if (property == "") { return this.fail(); }
                    property = this.normalizePropertyName(property);
                    i32[] ranges = UnicodeData::Ranges(property);
                    if (ranges.len() == 0) { return this.fail(); }
                    if (special == 80) { ranges = UnicodeData::Complement(ranges); }
                    i32 i = 0;
                    while (i < ranges.len() as i32) {
                        cls.addRange(ranges[i], ranges[i + 1]);
                        i = i + 2;
                    }
                    cls.unicode = true;
                    this.hasUnicode = true;
                    codeMode = true;
                    continue;
                }
                if (special == 100 || special == 68 || special == 119 || special == 87 || special == 115 || special == 83) {
                    bool classCode = codeMode || cls.unicode;
                    i32[] ranges = new i32[0];
                    if (special == 100 || special == 68) {
                        ranges = this.digitRanges(classCode);
                    } else if (special == 119 || special == 87) {
                        ranges = this.wordRanges(classCode);
                    } else {
                        ranges = this.spaceRanges(classCode);
                    }
                    bool invert = special == 68 || special == 87 || special == 83;
                    if (invert) {
                        i32 limit = 255;
                        if (classCode) { limit = 1114111; }
                        ranges = UnicodeData::ComplementTo(ranges, limit);
                    }
                    this.appendRanges(cls, ranges);
                    if (classCode) {
                        cls.unicode = true;
                        this.hasUnicode = true;
                        codeMode = true;
                    }
                    continue;
                }
                if (special == 110) { first = 10; }
                else if (special == 114) { first = 13; }
                else if (special == 116) { first = 9; }
                else if (special == 98) { first = 8; }
                else { first = special as i32; }
            } else {
                if (codeMode && this.currentByte() >= 128) {
                    i32[] code = new i32[1];
                    i32 step = this.decodePatternCode(this.pos, code);
                    if (step < 0) { return this.fail(); }
                    first = code[0];
                    this.pos = this.pos + step;
                } else {
                    first = this.currentByte() as i32;
                    this.pos = this.pos + 1;
                }
            }
            if (!this.atEnd() && this.currentByte() == 45 && this.pos + 1 < this.bytes.len() as i32 && this.bytes[this.pos + 1] != 93) {
                this.pos = this.pos + 1;
                i32 last = 0;
                if (this.currentByte() == 92) { return this.fail(); }
                if (codeMode && this.currentByte() >= 128) {
                    i32[] code = new i32[1];
                    i32 step = this.decodePatternCode(this.pos, code);
                    if (step < 0) { return this.fail(); }
                    last = code[0];
                    this.pos = this.pos + step;
                } else {
                    last = this.currentByte() as i32;
                    this.pos = this.pos + 1;
                }
                cls.addRange(first, last);
            } else {
                cls.addRange(first, first);
            }
        }
        if (!this.atEnd() && this.currentByte() == 93) {
            this.pos = this.pos + 1;
        } else {
            return this.fail();
        }
        if (this.wordUnicode && this.ignoreCase) {
            cls.unicode = true;
            this.addCaseVariants(cls);
            this.hasUnicode = true;
        }
        return this.classFrag(cls);
    }

    pub fn compile() -> Result<Regex, IoError> {
        RegexFrag frag = this.parseAlternation();
        if (this.failed || this.pos < this.bytes.len() as i32) {
            return Err(new IoError(22));
        }
        RegexClass dummy = new RegexClass(false);
        i32 matchState = this.addState(RegexState::MATCH, 0, dummy);
        frag = this.saveGroup(frag, 0);
        this.patch(frag, matchState);
        return Ok(new Regex(this.pattern, this.states, this.stateCount, frag.start, this.groupCount, this.hasLookahead, this.hasBackref, this.hasUnicode, this.groupNames));
    }
}

pub class Regex {
    string pattern;
    RegexState[] states;
    i32 stateCount;
    i32 start;
    i32 groupCount;
    bool hasLookahead;
    bool hasBackref;
    bool hasUnicode;
    string[] groupNames;

    pub fn init(string source, RegexState[] table, i32 total, i32 startIndex, i32 groups, bool lookahead, bool backref, bool unicode, string[] names) -> void {
        this.pattern = source;
        this.states = table;
        this.stateCount = total;
        this.start = startIndex;
        this.groupCount = groups;
        this.hasLookahead = lookahead;
        this.hasBackref = backref;
        this.hasUnicode = unicode;
        this.groupNames = names;
    }

    pub static fn Compile(string pattern) -> Result<Regex, IoError> {
        RegexCompiler compiler = new RegexCompiler(pattern);
        return compiler.compile();
    }


    fn isWordByte(u8 value) -> bool {
        i32 code = value as i32;
        return (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95;
    }

    fn codeAt(u8[] text, i32 pos) -> i32 {
        i32[] out = new i32[1];
        i32 step = this.decodeCodePoint(text, pos, out);
        if (step < 0) { return -1; }
        return out[0];
    }

    fn codeBefore(u8[] text, i32 pos) -> i32 {
        i32 start = pos - 1;
        while (start >= 0 && ((text[start] as i32) & 192) == 128) {
            start = start - 1;
        }
        if (start < 0) { return -1; }
        return this.codeAt(text, start);
    }

    fn boundaryAt(u8[] text, i32 pos, i32 flags, RegexClass cls) -> bool {
        bool unicode = (flags & RegexState::BOUNDARY_UNICODE) != 0;
        if (unicode) {
            if (pos > 0 && pos < text.len() as i32 && ((text[pos] as i32) & 192) == 128) {
                return false;
            }
        }
        bool left = false;
        bool right = false;
        if (unicode) {
            if (pos > 0) {
                i32 leftCode = this.codeBefore(text, pos);
                if (leftCode >= 0) { left = cls.matchesCode(leftCode); }
            }
            if (pos < text.len() as i32) {
                i32 rightCode = this.codeAt(text, pos);
                if (rightCode >= 0) { right = cls.matchesCode(rightCode); }
            }
        } else {
            left = pos > 0 && this.isWordByte(text[pos - 1]);
            right = pos < text.len() as i32 && this.isWordByte(text[pos]);
        }
        bool boundary = left != right;
        if ((flags & RegexState::BOUNDARY_NEGATIVE) != 0) { return !boundary; }
        return boundary;
    }

    fn addState(i32 stateIndex, u8[] text, i32 pos, bool[] seen, i32[] out, i32[] count) -> void {
        if (stateIndex < 0 || stateIndex >= this.stateCount || seen[stateIndex]) {
            return;
        }
        seen[stateIndex] = true;
        i32 op = this.states[stateIndex].op;
        if (op == RegexState::SPLIT) {
            this.addState(this.states[stateIndex].out1, text, pos, seen, out, count);
            this.addState(this.states[stateIndex].out2, text, pos, seen, out, count);
            return;
        }
        if (op == RegexState::EPS || op == RegexState::SAVE) {
            this.addState(this.states[stateIndex].out1, text, pos, seen, out, count);
            return;
        }
        if (op == RegexState::BOL) {
            bool ok = pos == 0;
            if (!ok && (this.states[stateIndex].ch & RegexState::MULTILINE) != 0) { ok = text[pos - 1] == 10; }
            if (ok) {
                this.addState(this.states[stateIndex].out1, text, pos, seen, out, count);
            }
            return;
        }
        if (op == RegexState::EOL) {
            bool ok = pos == text.len() as i32;
            if (!ok && (this.states[stateIndex].ch & RegexState::MULTILINE) != 0) { ok = text[pos] == 10; }
            if (ok) {
                this.addState(this.states[stateIndex].out1, text, pos, seen, out, count);
            }
            return;
        }
        if (op == RegexState::BOUNDARY) {
            if (this.boundaryAt(text, pos, this.states[stateIndex].ch, this.states[stateIndex].cls)) {
                this.addState(this.states[stateIndex].out1, text, pos, seen, out, count);
            }
            return;
        }
        out[count[0]] = stateIndex;
        count[0] = count[0] + 1;
    }

    fn hasMatch(i32[] set, i32 count) -> bool {
        i32 i = 0;
        while (i < count) {
            if (this.states[set[i]].op == RegexState::MATCH) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    fn foldByte(u8 value) -> u8 {
        i32 code = value as i32;
        if (code >= 65 && code <= 90) { return (code + 32) as u8; }
        if (code >= 97 && code <= 122) { return (code - 32) as u8; }
        return value;
    }

    fn literalMatches(i32 encoded, u8 value) -> bool {
        i32 expected = encoded & 255;
        if (expected == value as i32) { return true; }
        if ((encoded & RegexState::STATE_FLAG) == 0) { return false; }
        return this.foldByte(expected as u8) == value;
    }

    fn sameByte(u8 left, u8 right, bool ignoreCase) -> bool {
        if (left == right) { return true; }
        if (!ignoreCase) { return false; }
        return this.foldByte(left) == right;
    }

    fn sameFold(i32 left, i32 right) -> bool {
        return UnicodeData::Fold(left) == UnicodeData::Fold(right);
    }

    fn decodeCodePoint(u8[] text, i32 pos, i32[] out) -> i32 {
        i32 length = text.len() as i32;
        if (pos < 0 || pos >= length) { return -1; }
        i32 b0 = text[pos] as i32;
        if (b0 < 128) {
            out[0] = b0;
            return 1;
        }
        if (b0 < 192) { return -1; }
        if (b0 < 224) {
            if (pos + 1 >= length) { return -1; }
            i32 b1 = text[pos + 1] as i32;
            if ((b1 & 192) != 128) { return -1; }
            i32 code = ((b0 & 31) << 6) | (b1 & 63);
            if (code < 128) { return -1; }
            out[0] = code;
            return 2;
        }
        if (b0 < 240) {
            if (pos + 2 >= length) { return -1; }
            i32 b1 = text[pos + 1] as i32;
            i32 b2 = text[pos + 2] as i32;
            if ((b1 & 192) != 128 || (b2 & 192) != 128) { return -1; }
            i32 code = ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63);
            if (code < 2048 || (code >= 55296 && code <= 57343)) { return -1; }
            out[0] = code;
            return 3;
        }
        if (b0 < 248) {
            if (pos + 3 >= length) { return -1; }
            i32 b1 = text[pos + 1] as i32;
            i32 b2 = text[pos + 2] as i32;
            i32 b3 = text[pos + 3] as i32;
            if ((b1 & 192) != 128 || (b2 & 192) != 128 || (b3 & 192) != 128) { return -1; }
            i32 code = ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63);
            if (code < 65536 || code > 1114111) { return -1; }
            out[0] = code;
            return 4;
        }
        return -1;
    }

    fn accepts(i32 stateIndex, u8 value) -> bool {
        i32 op = this.states[stateIndex].op;
        if (op == RegexState::CHAR) {
            return this.literalMatches(this.states[stateIndex].ch, value);
        }
        if (op == RegexState::ANY) {
            if ((this.states[stateIndex].ch & RegexState::STATE_FLAG) != 0) { return true; }
            return value != 10;
        }
        if (op == RegexState::CLASS) {
            bool ignoreCase = (this.states[stateIndex].ch & RegexState::STATE_FLAG) != 0;
            return this.states[stateIndex].cls.matchesFold(value, ignoreCase);
        }
        return false;
    }

    // 返回从 start 开始的最长匹配结束字节偏移；没有匹配返回 -1。
    fn matchAt(u8[] text, i32 start) -> i64 {
        i32 length = text.len() as i32;
        i32[] current = new i32[this.stateCount];
        i32[] currentCount = new i32[1];
        currentCount[0] = 0;
        bool[] seen = new bool[this.stateCount];
        this.addState(this.start, text, start, seen, current, currentCount);
        i64 best = -1;
        if (this.hasMatch(current, currentCount[0])) {
            best = start as i64;
        }
        i32 pos = start;
        while (pos < length && currentCount[0] > 0) {
            i32[] next = new i32[this.stateCount];
            i32[] nextCount = new i32[1];
            nextCount[0] = 0;
            bool[] nextSeen = new bool[this.stateCount];
            i32 i = 0;
            while (i < currentCount[0]) {
                i32 stateIndex = current[i];
                if (this.accepts(stateIndex, text[pos])) {
                    this.addState(this.states[stateIndex].out1, text, pos + 1, nextSeen, next, nextCount);
                }
                i = i + 1;
            }
            current = next;
            currentCount = nextCount;
            seen = nextSeen;
            pos = pos + 1;
            if (this.hasMatch(current, currentCount[0])) {
                best = pos as i64;
            }
        }
        return best;
    }

    fn probeFrom(u8[] text, i32 bodyStart, i32 start, i32 target, i32[] captures, i32[] budget, bool commit) -> i32 {
        if (budget[0] <= 0) { return -1; }
        i32[] copy = new i32[captures.len()];
        i32 i = 0;
        while (i < captures.len() as i32) {
            copy[i] = captures[i];
            i = i + 1;
        }
        bool matched = this.dfs(text, bodyStart, start, copy, budget, target);
        if (!matched && budget[0] <= 0) { return -1; }
        if (matched && commit) {
            i = 2;
            while (i < captures.len() as i32) {
                captures[i] = copy[i];
                i = i + 1;
            }
        }
        if (matched) { return 1; }
        return 0;
    }

    fn probeLook(u8[] text, i32 state, i32 pos, i32[] captures, i32[] budget) -> i32 {
        i32 flags = this.states[state].ch;
        bool negative = (flags & RegexState::LOOK_NEGATIVE) != 0;
        bool behind = (flags & RegexState::LOOK_BEHIND) != 0;
        bool commit = !negative;
        i32 bodyStart = this.states[state].out2;
        if (!behind) {
            return this.probeFrom(text, bodyStart, pos, -1, captures, budget, commit);
        }
        i32 start = pos;
        while (start >= 0) {
            i32 probed = this.probeFrom(text, bodyStart, start, pos, captures, budget, commit);
            if (probed != 0) { return probed; }
            start = start - 1;
        }
        return 0;
    }

    fn dfs(u8[] text, i32 state, i32 pos, i32[] captures, i32[] budget, i32 target) -> bool {
        if (budget[0] <= 0) { return false; }
        budget[0] = budget[0] - 1;
        if (state < 0 || state >= this.stateCount) { return false; }
        i32 op = this.states[state].op;
        if (op == RegexState::MATCH || op == RegexState::ASSERT_MATCH) {
            if (target >= 0 && pos != target) { return false; }
            captures[1] = pos;
            return true;
        }
        if (op == RegexState::SAVE) {
            i32 slot = this.states[state].ch;
            if (slot < 0 || slot >= captures.len() as i32) { return false; }
            i32 old = captures[slot];
            captures[slot] = pos;
            bool matched = this.dfs(text, this.states[state].out1, pos, captures, budget, target);
            if (matched) { return true; }
            captures[slot] = old;
            return false;
        }
        if (op == RegexState::SPLIT) {
            if (this.dfs(text, this.states[state].out1, pos, captures, budget, target)) { return true; }
            return this.dfs(text, this.states[state].out2, pos, captures, budget, target);
        }
        if (op == RegexState::BOL) {
            bool ok = pos == 0;
            if (!ok && (this.states[state].ch & RegexState::MULTILINE) != 0) { ok = text[pos - 1] == 10; }
            if (ok) { return this.dfs(text, this.states[state].out1, pos, captures, budget, target); }
            return false;
        }
        if (op == RegexState::EOL) {
            bool ok = pos == text.len() as i32;
            if (!ok && (this.states[state].ch & RegexState::MULTILINE) != 0) { ok = text[pos] == 10; }
            if (ok) { return this.dfs(text, this.states[state].out1, pos, captures, budget, target); }
            return false;
        }
        if (op == RegexState::BOUNDARY) {
            if (this.boundaryAt(text, pos, this.states[state].ch, this.states[state].cls)) { return this.dfs(text, this.states[state].out1, pos, captures, budget, target); }
            return false;
        }
        if (op == RegexState::EPS) {
            return this.dfs(text, this.states[state].out1, pos, captures, budget, target);
        }
        if (op == RegexState::LOOK) {
            i32[] before = new i32[captures.len()];
            i32 i = 0;
            while (i < captures.len() as i32) {
                before[i] = captures[i];
                i = i + 1;
            }
            i32 probed = this.probeLook(text, state, pos, captures, budget);
            if (probed < 0) { return false; }
            bool positive = (this.states[state].ch & RegexState::LOOK_NEGATIVE) == 0;
            if (positive) {
                if (probed == 0) { return false; }
            } else {
                if (probed == 1) { return false; }
            }
            bool matched = this.dfs(text, this.states[state].out1, pos, captures, budget, target);
            if (!matched) {
                i = 0;
                while (i < captures.len() as i32) {
                    captures[i] = before[i];
                    i = i + 1;
                }
            }
            return matched;
        }
        if (op == RegexState::BACKREF) {
            i32 encoded = this.states[state].ch;
            i32 group = encoded & 255;
            bool ignoreCase = (encoded & RegexState::STATE_FLAG) != 0;
            bool unicode = (encoded & RegexState::BACKREF_UNICODE) != 0;
            i32 firstSlot = group * 2;
            i32 lastSlot = firstSlot + 1;
            if (firstSlot < 0 || lastSlot >= captures.len() as i32) { return false; }
            i32 first = captures[firstSlot];
            i32 last = captures[lastSlot];
            if (first < 0 || last < first) { return false; }
            if (unicode) {
                i32 sourcePos = first;
                i32 targetPos = pos;
                while (sourcePos < last) {
                    i32[] sourceCode = new i32[1];
                    i32[] targetCode = new i32[1];
                    i32 sourceStep = this.decodeCodePoint(text, sourcePos, sourceCode);
                    i32 targetStep = this.decodeCodePoint(text, targetPos, targetCode);
                    if (sourceStep < 0 || targetStep < 0) { return false; }
                    if (!this.sameFold(sourceCode[0], targetCode[0])) { return false; }
                    sourcePos = sourcePos + sourceStep;
                    targetPos = targetPos + targetStep;
                }
                return this.dfs(text, this.states[state].out1, targetPos, captures, budget, target);
            }
            i32 n = last - first;
            if (pos + n > text.len() as i32) { return false; }
            i32 i = 0;
            while (i < n) {
                if (!this.sameByte(text[first + i], text[pos + i], ignoreCase)) { return false; }
                i = i + 1;
            }
            return this.dfs(text, this.states[state].out1, pos + n, captures, budget, target);
        }
        if (op == RegexState::CODEPOINT || op == RegexState::CLASS_CODE) {
            i32[] code = new i32[1];
            i32 step = this.decodeCodePoint(text, pos, code);
            if (step < 0) { return false; }
            if (!this.states[state].cls.matchesCode(code[0])) { return false; }
            return this.dfs(text, this.states[state].out1, pos + step, captures, budget, target);
        }
        if (pos >= text.len() as i32) { return false; }
        if (!this.accepts(state, text[pos])) { return false; }
        return this.dfs(text, this.states[state].out1, pos + 1, captures, budget, target);
    }

    fn searchBudget(i32 length) -> i32 {
        i32 budget = 200000 + length * 4 + this.stateCount * 8;
        if (budget > 1000000) { budget = 1000000; }
        return budget;
    }

    fn dfsLongest(u8[] text, i32 state, i32 pos, i32[] captures, i32[] budget, i32[] best) -> void {
        if (budget[0] <= 0) { return; }
        budget[0] = budget[0] - 1;
        if (state < 0 || state >= this.stateCount) { return; }
        i32 op = this.states[state].op;
        if (op == RegexState::MATCH || op == RegexState::ASSERT_MATCH) {
            if (pos > best[0]) { best[0] = pos; }
            return;
        }
        if (op == RegexState::SAVE) {
            i32 slot = this.states[state].ch;
            if (slot < 0 || slot >= captures.len() as i32) { return; }
            i32 old = captures[slot];
            captures[slot] = pos;
            this.dfsLongest(text, this.states[state].out1, pos, captures, budget, best);
            captures[slot] = old;
            return;
        }
        if (op == RegexState::SPLIT) {
            this.dfsLongest(text, this.states[state].out1, pos, captures, budget, best);
            this.dfsLongest(text, this.states[state].out2, pos, captures, budget, best);
            return;
        }
        if (op == RegexState::BOL) {
            bool ok = pos == 0;
            if (!ok && (this.states[state].ch & RegexState::MULTILINE) != 0) { ok = text[pos - 1] == 10; }
            if (ok) {
                this.dfsLongest(text, this.states[state].out1, pos, captures, budget, best);
            }
            return;
        }
        if (op == RegexState::EOL) {
            bool ok = pos == text.len() as i32;
            if (!ok && (this.states[state].ch & RegexState::MULTILINE) != 0) { ok = text[pos] == 10; }
            if (ok) {
                this.dfsLongest(text, this.states[state].out1, pos, captures, budget, best);
            }
            return;
        }
        if (op == RegexState::BOUNDARY) {
            if (this.boundaryAt(text, pos, this.states[state].ch, this.states[state].cls)) {
                this.dfsLongest(text, this.states[state].out1, pos, captures, budget, best);
            }
            return;
        }
        if (op == RegexState::EPS) {
            this.dfsLongest(text, this.states[state].out1, pos, captures, budget, best);
            return;
        }
        if (op == RegexState::LOOK) {
            i32 probed = this.probeLook(text, state, pos, captures, budget);
            if (probed < 0) { return; }
            bool positive = (this.states[state].ch & RegexState::LOOK_NEGATIVE) == 0;
            if (positive && probed == 0) { return; }
            if (!positive && probed == 1) { return; }
            this.dfsLongest(text, this.states[state].out1, pos, captures, budget, best);
            return;
        }
        if (op == RegexState::BACKREF) {
            i32 encoded = this.states[state].ch;
            i32 group = encoded & 255;
            bool ignoreCase = (encoded & RegexState::STATE_FLAG) != 0;
            bool unicode = (encoded & RegexState::BACKREF_UNICODE) != 0;
            i32 firstSlot = group * 2;
            i32 lastSlot = firstSlot + 1;
            if (firstSlot < 0 || lastSlot >= captures.len() as i32) { return; }
            i32 first = captures[firstSlot];
            i32 last = captures[lastSlot];
            if (first < 0 || last < first) { return; }
            if (unicode) {
                i32 sourcePos = first;
                i32 targetPos = pos;
                while (sourcePos < last) {
                    i32[] sourceCode = new i32[1];
                    i32[] targetCode = new i32[1];
                    i32 sourceStep = this.decodeCodePoint(text, sourcePos, sourceCode);
                    i32 targetStep = this.decodeCodePoint(text, targetPos, targetCode);
                    if (sourceStep < 0 || targetStep < 0) { return; }
                    if (!this.sameFold(sourceCode[0], targetCode[0])) { return; }
                    sourcePos = sourcePos + sourceStep;
                    targetPos = targetPos + targetStep;
                }
                this.dfsLongest(text, this.states[state].out1, targetPos, captures, budget, best);
                return;
            }
            i32 n = last - first;
            if (pos + n > text.len() as i32) { return; }
            i32 i = 0;
            while (i < n) {
                if (!this.sameByte(text[first + i], text[pos + i], ignoreCase)) { return; }
                i = i + 1;
            }
            this.dfsLongest(text, this.states[state].out1, pos + n, captures, budget, best);
            return;
        }
        if (op == RegexState::CODEPOINT || op == RegexState::CLASS_CODE) {
            i32[] code = new i32[1];
            i32 step = this.decodeCodePoint(text, pos, code);
            if (step < 0) { return; }
            if (!this.states[state].cls.matchesCode(code[0])) { return; }
            this.dfsLongest(text, this.states[state].out1, pos + step, captures, budget, best);
            return;
        }
        if (pos >= text.len() as i32) { return; }
        if (!this.accepts(state, text[pos])) { return; }
        this.dfsLongest(text, this.states[state].out1, pos + 1, captures, budget, best);
    }

    fn findBytesBacktrack(u8[] text, i32 from) -> Option<RegexMatch> {
        i32 length = text.len() as i32;
        i32 start = from;
        while (start <= length) {
            i32[] captures = new i32[this.groupCount * 2];
            i32 i = 0;
            while (i < this.groupCount * 2) {
                captures[i] = -1;
                i = i + 1;
            }
            i32[] budget = new i32[1];
            budget[0] = this.searchBudget(length);
            i32[] best = new i32[1];
            best[0] = -1;
            this.dfsLongest(text, this.start, start, captures, budget, best);
            if (best[0] >= 0) {
                return Some(new RegexMatch(start as i64, best[0] as i64));
            }
            start = start + 1;
        }
        return None;
    }

    fn findCapturesFrom(u8[] data, i32 from) -> Option<RegexCaptures> {
        i32 length = data.len() as i32;
        i32 start = from;
        while (start <= length) {
            i32[] captures = new i32[this.groupCount * 2];
            i32 i = 0;
            while (i < this.groupCount * 2) {
                captures[i] = -1;
                i = i + 1;
            }
            i32[] budget = new i32[1];
            budget[0] = this.searchBudget(length);
            if (this.dfs(data, this.start, start, captures, budget, -1)) {
                return Some(new RegexCaptures(captures, this.groupNames));
            }
            start = start + 1;
        }
        return None;
    }

    // 返回捕获组结果；采用左优先/贪婪回溯语义，组 0 是整个匹配。
    pub fn findCaptures(string text) -> Option<RegexCaptures> {
        return this.findCapturesFrom(Str::Bytes(text), 0);
    }

    fn findBytes(u8[] text, i32 from) -> Option<RegexMatch> {
        if (this.hasLookahead || this.hasBackref || this.hasUnicode) {
            return this.findBytesBacktrack(text, from);
        }
        i32 length = text.len() as i32;
        i32 start = from;
        while (start <= length) {
            i64 finish = this.matchAt(text, start);
            if (finish >= 0) {
                return Some(new RegexMatch(start as i64, finish));
            }
            start = start + 1;
        }
        return None;
    }

    pub fn isMatch(string text) -> bool {
        Option<RegexMatch> found = this.find(text);
        match found {
            Some(_) => { return true; }
            None => { return false; }
        }
    }

    pub fn find(string text) -> Option<RegexMatch> {
        return this.findBytes(Str::Bytes(text), 0);
    }

    pub fn findAll(string text) -> Vec<RegexMatch> {
        u8[] data = Str::Bytes(text);
        Vec<RegexMatch> out = new Vec<RegexMatch>();
        i32 cursor = 0;
        i32 length = data.len() as i32;
        while (cursor <= length) {
            Option<RegexMatch> found = this.findBytes(data, cursor);
            match found {
                Some(value) => {
                    out.push(value);
                    i32 next = value.end as i32;
                    if (next == cursor) {
                        next = next + 1;
                    }
                    cursor = next;
                }
                None => { break; }
            }
        }
        return out;
    }

    // 按正则分隔符切分；零宽匹配不消耗字符，但在该位置切分一次。
    pub fn split(string text) -> Vec<string> {
        u8[] data = Str::Bytes(text);
        Vec<string> out = new Vec<string>();
        i64 cursor = 0;
        i64 last = 0;
        i64 length = data.len() as i64;
        while (cursor <= length) {
            Option<RegexMatch> found = this.findBytes(data, cursor as i32);
            match found {
                Some(value) => {
                    out.push(Str::Substring(text, last as u64, (value.start - last) as u64));
                    last = value.end;
                    if (value.end == value.start) {
                        cursor = value.end + 1;
                    } else {
                        cursor = value.end;
                    }
                }
                None => { break; }
            }
        }
        out.push(Str::Substring(text, last as u64, (length - last) as u64));
        return out;
    }

    pub fn replaceAll(string text, string replacement) -> string {
        u8[] data = Str::Bytes(text);
        StringBuilder out = new StringBuilder();
        i64 cursor = 0;
        i64 length = data.len() as i64;
        while (cursor <= length) {
            Option<RegexMatch> found = this.findBytes(data, cursor as i32);
            match found {
                Some(value) => {
                    out.append(Str::Substring(text, cursor as u64, (value.start - cursor) as u64));
                    out.append(replacement);
                    if (value.end == value.start) {
                        if (value.end < length) {
                            out.append(Str::Substring(text, value.end as u64, 1));
                        }
                        cursor = value.end + 1;
                    } else {
                        cursor = value.end;
                    }
                }
                None => { break; }
            }
        }
        if (cursor < length) {
            out.append(Str::Substring(text, cursor as u64, (length - cursor) as u64));
        }
        return out.toString();
    }

    // 捕获组替换：$0..$9 按组号、${name} 按组名、${10} 支持多位组号；\$ 与 $$ 输出字面量 $。
    pub fn replaceAllCaptures(string text, string replacement) -> string {
        u8[] data = Str::Bytes(text);
        StringBuilder out = new StringBuilder();
        i64 cursor = 0;
        i64 length = data.len() as i64;
        while (cursor <= length) {
            Option<RegexCaptures> found = this.findCapturesFrom(data, cursor as i32);
            match found {
                Some(captures) => {
                    Option<RegexMatch> whole = captures.group(0);
                    match whole {
                        Some(value) => {
                            out.append(Str::Substring(text, cursor as u64, (value.start - cursor) as u64));
                            out.append(this.expandReplacement(text, replacement, captures));
                            if (value.end == value.start) {
                                if (value.end < length) {
                                    out.append(Str::Substring(text, value.end as u64, 1));
                                }
                                cursor = value.end + 1;
                            } else {
                                cursor = value.end;
                            }
                        }
                        None => { break; }
                    }
                }
                None => { break; }
            }
        }
        if (cursor < length) {
            out.append(Str::Substring(text, cursor as u64, (length - cursor) as u64));
        }
        return out.toString();
    }

    fn groupNumber(string value) -> i32 {
        u8[] bytes = Str::Bytes(value);
        if (bytes.len() == 0) { return -1; }
        i32 number = 0;
        i32 i = 0;
        while (i < bytes.len() as i32) {
            u8 c = bytes[i];
            if (c < 48 || c > 57) { return -1; }
            number = number * 10 + (c as i32 - 48);
            if (number > 10000) { return -1; }
            i = i + 1;
        }
        return number;
    }

    fn expandReplacement(string source, string replacement, RegexCaptures captures) -> string {
        u8[] bytes = Str::Bytes(replacement);
        i32 length = bytes.len() as i32;
        StringBuilder out = new StringBuilder();
        i32 i = 0;
        while (i < length) {
            u8 c = bytes[i];
            if (c == 92 && i + 1 < length && bytes[i + 1] == 36) {
                out.append("$");
                i = i + 2;
                continue;
            }
            if (c == 36) {
                if (i + 1 < length && bytes[i + 1] == 36) {
                    out.append("$");
                    i = i + 2;
                    continue;
                }
                if (i + 1 < length && bytes[i + 1] == 123) {
                    i32 close = i + 2;
                    while (close < length && bytes[close] != 125) {
                        close = close + 1;
                    }
                    if (close < length) {
                        string name = Str::Substring(replacement, (i + 2) as u64, (close - i - 2) as u64);
                        i32 number = this.groupNumber(name);
                        if (number >= 0) {
                            out.append(captures.text(source, number));
                        } else {
                            out.append(captures.textNamed(source, name));
                        }
                        i = close + 1;
                        continue;
                    }
                }
                if (i + 1 < length && bytes[i + 1] >= 48 && bytes[i + 1] <= 57) {
                    out.append(captures.text(source, bytes[i + 1] as i32 - 48));
                    i = i + 2;
                    continue;
                }
            }
            out.append(Str::Substring(replacement, i as u64, 1));
            i = i + 1;
        }
        return out.toString();
    }
}
