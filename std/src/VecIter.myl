// Vec<T> 的显式迭代器；构造时持有 Vec 引用，不复制元素。
import { Vec } from "Vec.myl";

pub class VecIter<T> {
    Vec<T> values;
    i64 index;

    pub fn init(Vec<T> values) -> void {
        this.values = values;
        this.index = 0;
    }

    pub fn next() -> Option<T> {
        if (this.index >= this.values.len()) {
            return None;
        }
        T value = this.values.get(this.index);
        this.index = this.index + 1;
        return Some(value);
    }
}

pub fn iter<T>(Vec<T> values) -> VecIter<T> {
    return new VecIter<T>(values);
}
