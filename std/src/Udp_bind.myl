// std UDP native 后端绑定。
@header("mylis_udp.h")
pub unsafe fn mylis_udp_bind(i8* address) -> i64;

@header("mylis_udp.h")
pub unsafe fn mylis_udp_port(i64 handle) -> i64;

@header("mylis_udp.h")
pub unsafe fn mylis_udp_send(i64 handle, i8* address, u8[] data, i64 offset, i64 count) -> i64;

@header("mylis_udp.h")
pub unsafe fn mylis_udp_recv(i64 handle, u8[] data, i64 offset, i64 count) -> i64;

@header("mylis_udp.h")
pub unsafe fn mylis_udp_recv_from(i64 handle, u8[] data, i64 offset, i64 count, u8[] from, i64[] from_meta) -> i64;

@header("mylis_udp.h")
pub unsafe fn mylis_udp_set_nonblocking(i64 handle, i32 enabled) -> i64;

@header("mylis_udp.h")
pub unsafe fn mylis_udp_fd(i64 handle) -> i64;

@header("mylis_udp.h")
pub unsafe fn mylis_udp_close(i64 handle) -> i64;

@header("mylis_udp.h")
pub unsafe fn mylis_udp_set_reuse_address(i64 handle, i32 enabled) -> i64;

@header("mylis_udp.h")
pub unsafe fn mylis_udp_set_broadcast(i64 handle, i32 enabled) -> i64;

@header("mylis_udp.h")
pub unsafe fn mylis_udp_set_ttl(i64 handle, i32 ttl) -> i64;
