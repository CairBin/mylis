// Popen/Popen2 管道句柄：Popen 为单向，Popen2 同时有 stdin/stdout。
// 管道 fd 和子进程都由 native 侧管理；显式 close 回收，不依赖 GC 析构。
import { IoError } from "IoError.myl";
import { ProcessStatus } from "ProcessStatus.myl";
import { myrt_str_cstr } from "core/Mylrt_bind";
import { mylis_process_pipe_pid, mylis_process_pipe_read_all, mylis_process_pipe_read_line_timeout, mylis_process_pipe_last_status, mylis_process_pipe_read_copy, mylis_process_pipe_write_timeout, mylis_process_pipe_close_input, mylis_process_pipe_close, mylis_process_pipe_terminate, mylis_process_last_wait_exit_code, mylis_process_last_wait_signal, mylis_process_free_string } from "Process_bind.myl";

pub class ProcessPipe {
    i64 handle;

    pub fn init(i64 h) -> void {
        this.handle = h;
    }

    pub fn pid() -> i64 {
        i64 value = 0;
        unsafe {
            value = mylis_process_pipe_pid(this.handle);
        }
        return value;
    }

    // 读模式下读一行（行尾 \n/\r\n 去掉）；EOF 返回 None。
    pub fn readLine() -> Result<Option<string>, IoError> {
        return this.readLineCore(-1);
    }

    // 读模式下最多等待 timeoutMs 毫秒读一行；超时返回 IoError(110)。
    pub fn readLineTimeout(i64 timeoutMs) -> Result<Option<string>, IoError> {
        return this.readLineCore(timeoutMs);
    }

    fn readLineCore(i64 timeoutMs) -> Result<Option<string>, IoError> {
        i64 status = 0;
        string text = "";
        unsafe {
            i8* raw = mylis_process_pipe_read_line_timeout(this.handle, timeoutMs);
            status = mylis_process_pipe_last_status();
            text = myrt_str_cstr(raw);
            mylis_process_free_string(raw);
        }
        if (status < 0) {
            return Err(new IoError((-status) as i32));
        }
        if (status == 0) {
            return Ok(None);
        }
        return Ok(Some(text));
    }

    // 读模式下读取剩余 stdout 到 EOF，返回原始字节。
    pub fn readAll() -> Result<u8[], IoError> {
        i64 n = 0;
        unsafe {
            n = mylis_process_pipe_read_all(this.handle);
        }
        if (n < 0) {
            return Err(new IoError((-n) as i32));
        }
        if (n == 0) {
            return Ok(new u8[0]);
        }
        u8[] data = new u8[n];
        i64 got = 0;
        unsafe {
            got = mylis_process_pipe_read_copy(this.handle, data, 0, n);
        }
        if (got < 0) {
            return Err(new IoError((-got) as i32));
        }
        return Ok(data);
    }

    // 双向管道关闭 stdin，通知子进程输入结束；写模式下也可调用。
    pub fn closeInput() -> Result<i64, IoError> {
        i64 rc = 0;
        unsafe {
            rc = mylis_process_pipe_close_input(this.handle);
        }
        if (rc < 0) {
            return Err(new IoError((-rc) as i32));
        }
        return Ok(rc);
    }

    // 写模式把字节写入子进程 stdin；管道满时阻塞，直到子进程读取或关闭。
    pub fn write(u8[] data) -> Result<i64, IoError> {
        return this.writeTimeout(data, -1);
    }

    // 写模式把字节写入子进程 stdin；最多等待 timeoutMs 毫秒，超时返回 IoError(110)。
    // 可能已经写入一部分字节；超时后管道协议可能失步，调用方应 terminate 子进程。
    pub fn writeTimeout(u8[] data, i64 timeoutMs) -> Result<i64, IoError> {
        i64 count = data.len() as i64;
        i64 rc = 0;
        unsafe {
            rc = mylis_process_pipe_write_timeout(this.handle, data, 0, count, timeoutMs);
        }
        if (rc < 0) {
            return Err(new IoError((-rc) as i32));
        }
        return Ok(rc);
    }

    // 关闭管道并等待子进程结束；返回最终状态。
    pub fn close() -> Result<ProcessStatus, IoError> {
        i64 rc = 0;
        unsafe {
            rc = mylis_process_pipe_close(this.handle);
        }
        if (rc < 0) {
            return Err(new IoError((-rc) as i32));
        }
        return Ok(this.lastStatus());
    }

    // 强制结束子进程：先 kill，再关闭管道并 wait。用于 close() 可能永久阻塞的 worker。
    pub fn terminate() -> Result<ProcessStatus, IoError> {
        i64 rc = 0;
        unsafe {
            rc = mylis_process_pipe_terminate(this.handle);
        }
        if (rc < 0) {
            return Err(new IoError((-rc) as i32));
        }
        return Ok(this.lastStatus());
    }

    fn lastStatus() -> ProcessStatus {
        i64 code = 0;
        i64 signal = 0;
        unsafe {
            code = mylis_process_last_wait_exit_code();
            signal = mylis_process_last_wait_signal();
        }
        return new ProcessStatus(code, signal);
    }
}
