    pub static fn Complement(i32[] ranges) -> i32[] {
        return UnicodeData::ComplementTo(ranges, 1114111);
    }

    static fn SortRanges(i32[] ranges) -> void {
        i32 i = 0;
        while (i + 1 < ranges.len() as i32) {
            i32 j = i + 2;
            while (j + 1 < ranges.len() as i32) {
                if (ranges[j] < ranges[i]) {
                    i32 first = ranges[i];
                    i32 last = ranges[i + 1];
                    ranges[i] = ranges[j];
                    ranges[i + 1] = ranges[j + 1];
                    ranges[j] = first;
                    ranges[j + 1] = last;
                }
                j = j + 2;
            }
            i = i + 2;
        }
    }

    pub static fn ComplementTo(i32[] ranges, i32 limit) -> i32[] {
        UnicodeData::SortRanges(ranges);
        i32 count = 0;
        i32 cursor = 0;
        i32 i = 0;
        while (i < ranges.len() as i32) {
            i32 start = ranges[i];
            i32 end = ranges[i + 1];
            if (cursor < start) { count = count + 2; }
            cursor = end + 1;
            i = i + 2;
        }
        if (cursor <= limit) { count = count + 2; }
        i32[] out = new i32[count];
        i32 at = 0;
        cursor = 0;
        i = 0;
        while (i < ranges.len() as i32) {
            i32 start = ranges[i];
            i32 end = ranges[i + 1];
            if (cursor < start) {
                out[at] = cursor;
                out[at + 1] = start - 1;
                at = at + 2;
            }
            cursor = end + 1;
            i = i + 2;
        }
        if (cursor <= limit) {
            out[at] = cursor;
            out[at + 1] = limit;
            at = at + 2;
        }
        return out;
    }

    pub static fn Fold(i32 code) -> i32 {
        i32[] table = UnicodeData::FoldPairs();
        i32 low = 0;
        i32 high = (table.len() as i32) / 2 - 1;
        while (low <= high) {
            i32 mid = (low + high) / 2;
            i32 key = table[mid * 2];
            if (key == code) { return table[mid * 2 + 1]; }
            if (key < code) { low = mid + 1; } else { high = mid - 1; }
        }
        return code;
    }

