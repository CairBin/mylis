// WorkerPool：固定数量的独立 worker 进程，做同步 fan-out/fan-in。
// 任务按提交顺序返回；任一 send/recv 失败或超时都会强制清理整池。
import { Worker } from "Worker.myl";
import { ProcessStatus } from "ProcessStatus.myl";
import { IoError } from "IoError.myl";
import { Vec } from "Vec.myl";

pub class WorkerPool {
    Vec<Worker> workers;

    pub fn init(Vec<Worker> list) -> void {
        this.workers = list;
    }

    pub static fn Spawn(string command, i64 count) -> Result<WorkerPool, IoError> {
        if (count <= 0) {
            return Err(new IoError(22));
        }
        Vec<Worker> list = new Vec<Worker>();
        i64 i = 0;
        while (i < count) {
            Result<Worker, IoError> spawned = Worker::Spawn(command);
            match (spawned) {
                Ok(worker) => { list.push(worker); }
                Err(error) => {
                    i64 j = 0;
                    while (j < list.len) {
                        list.get(j).terminate();
                        j = j + 1;
                    }
                    return Err(error);
                }
            }
            i = i + 1;
        }
        return Ok(new WorkerPool(list));
    }

    pub fn count() -> i64 {
        return this.workers.len;
    }

    // 同步提交 tasks，按 tasks 的顺序返回结果。
    pub fn callAll(Vec<string> tasks) -> Result<Vec<string>, IoError> {
        return this.callAllCore(tasks, -1);
    }

    // 每条响应最多等待 timeoutMs 毫秒；超时会强制清理整池并返回 IoError(110)。
    pub fn callAllTimeout(Vec<string> tasks, i64 timeoutMs) -> Result<Vec<string>, IoError> {
        return this.callAllCore(tasks, timeoutMs);
    }

    fn callAllCore(Vec<string> tasks, i64 timeoutMs) -> Result<Vec<string>, IoError> {
        i64 total = tasks.len();
        Vec<string> results = new Vec<string>();
        results.resize(total, "");
        i64 workerCount = this.workers.len;
        if (total == 0) {
            return Ok(results);
        }
        if (workerCount == 0) {
            return Err(new IoError(22));
        }

        Vec<i64> slots = new Vec<i64>();
        slots.resize(workerCount, -1);
        i64 next = 0;
        i64 i = 0;
        while (i < workerCount && next < total) {
            Result<i64, IoError> sent = this.workers.get(i).send(tasks.get(next));
            match (sent) {
                Ok(ignored) => { slots.set(i, next); next = next + 1; }
                Err(error) => { this.terminate(); return Err(error); }
            }
            i = i + 1;
        }

        i64 completed = 0;
        while (completed < total) {
            i = 0;
            while (i < workerCount && completed < total) {
                i64 slot = slots.get(i);
                if (slot >= 0) {
                    Result<Option<string>, IoError> response = this.workers.get(i).recvTimeout(timeoutMs);
                    match (response) {
                        Ok(value) => {
                            match (value) {
                                Some(text) => {
                                    results.set(slot, text);
                                    slots.set(i, -1);
                                    completed = completed + 1;
                                    if (next < total) {
                                        Result<i64, IoError> sentNext = this.workers.get(i).send(tasks.get(next));
                                        match (sentNext) {
                                            Ok(ignored) => { slots.set(i, next); next = next + 1; }
                                            Err(error) => { this.terminate(); return Err(error); }
                                        }
                                    }
                                }
                                None => { this.terminate(); return Err(new IoError(9)); }
                            }
                        }
                        Err(error) => { this.terminate(); return Err(error); }
                    }
                }
                i = i + 1;
            }
        }
        return Ok(results);
    }

    // 正常关闭所有 worker；任一失败则强制清理整池。
    pub fn close() -> Result<i64, IoError> {
        i64 i = 0;
        while (i < this.workers.len) {
            Result<ProcessStatus, IoError> closed = this.workers.get(i).close();
            match (closed) {
                Ok(status) => { }
                Err(error) => { this.terminate(); return Err(error); }
            }
            i = i + 1;
        }
        return Ok(this.workers.len);
    }

    // 强制清理整池；忽略单个 worker 的清理错误，返回尝试过的 worker 数量。
    pub fn terminate() -> i64 {
        i64 i = 0;
        while (i < this.workers.len) {
            this.workers.get(i).terminate();
            i = i + 1;
        }
        return this.workers.len;
    }
}
