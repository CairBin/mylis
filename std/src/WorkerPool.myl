// WorkerPool：固定数量的独立 worker 进程，做同步 fan-out/fan-in。
// callAll 保持全有或全无语义；callAllResults 对单个任务失败隔离并在原槽位重启 worker。
import { Worker } from "Worker.myl";
import { WorkerTaskResult } from "WorkerTaskResult.myl";
import { ProcessStatus } from "ProcessStatus.myl";
import { IoError } from "IoError.myl";
import { Vec } from "Vec.myl";

pub class WorkerPool {
    string command;
    Vec<Worker> workers;

    pub fn init(string cmd, Vec<Worker> list) -> void {
        this.command = cmd;
        this.workers = list;
    }

    pub static fn Spawn(string command, i64 count) -> Result<WorkerPool, IoError> {
        if (count <= 0) {
            return Err(new IoError(22));
        }
        Vec<Worker> list = new Vec<Worker>();
        i64 i = 0;
        while (i < count) {
            Result<Worker, IoError> spawned = Worker::Spawn(command);
            match (spawned) {
                Ok(worker) => { list.push(worker); }
                Err(error) => {
                    i64 j = 0;
                    while (j < list.len) {
                        list.get(j).terminate();
                        j = j + 1;
                    }
                    return Err(error);
                }
            }
            i = i + 1;
        }
        return Ok(new WorkerPool(command, list));
    }

    pub fn count() -> i64 {
        return this.workers.len;
    }

    // 同步提交 tasks，按 tasks 的顺序返回结果；任一任务失败则整次失败。
    pub fn callAll(Vec<string> tasks) -> Result<Vec<string>, IoError> {
        Result<Vec<WorkerTaskResult>, IoError> results = this.callAllCore(tasks, -1);
        match (results) {
            Ok(values) => { return this.toTextResults(values); }
            Err(error) => { return Err(error); }
        }
    }

    // 每条响应最多等待 timeoutMs 毫秒；任一任务失败则整次失败。
    pub fn callAllTimeout(Vec<string> tasks, i64 timeoutMs) -> Result<Vec<string>, IoError> {
        Result<Vec<WorkerTaskResult>, IoError> results = this.callAllCore(tasks, timeoutMs);
        match (results) {
            Ok(values) => { return this.toTextResults(values); }
            Err(error) => { return Err(error); }
        }
    }

    // 每个任务单独返回成功/失败；worker 超时/退出时只重启该槽位，继续处理其他任务。
    pub fn callAllResults(Vec<string> tasks, i64 timeoutMs) -> Result<Vec<WorkerTaskResult>, IoError> {
        return this.callAllCore(tasks, timeoutMs);
    }

    fn toTextResults(Vec<WorkerTaskResult> results) -> Result<Vec<string>, IoError> {
        Vec<string> texts = new Vec<string>();
        i64 i = 0;
        while (i < results.len) {
            WorkerTaskResult item = results.get(i);
            if (!item.ok) {
                return Err(new IoError(item.code));
            }
            texts.push(item.value);
            i = i + 1;
        }
        return Ok(texts);
    }

    fn callAllCore(Vec<string> tasks, i64 timeoutMs) -> Result<Vec<WorkerTaskResult>, IoError> {
        i64 total = tasks.len();
        Vec<WorkerTaskResult> results = new Vec<WorkerTaskResult>();
        results.resize(total, WorkerTaskResult::Failure(0));
        i64 workerCount = this.workers.len;
        if (total == 0) {
            return Ok(results);
        }
        if (workerCount == 0) {
            return Err(new IoError(22));
        }

        Vec<i64> slots = new Vec<i64>();
        slots.resize(workerCount, -1);
        i64 next = 0;
        i64 completed = 0;
        while (completed < total) {
            i64 i = 0;
            while (i < workerCount && completed < total) {
                i64 slot = slots.get(i);
                if (slot >= 0) {
                    Result<Option<string>, IoError> response = this.workers.get(i).recvTimeout(timeoutMs);
                    match (response) {
                        Ok(value) => {
                            match (value) {
                                Some(text) => {
                                    results.set(slot, WorkerTaskResult::Success(text));
                                    slots.set(i, -1);
                                    completed = completed + 1;
                                    if (next < total) {
                                        Result<i64, IoError> sentNext = this.workers.get(i).send(tasks.get(next));
                                        match (sentNext) {
                                            Ok(ignored) => { slots.set(i, next); next = next + 1; }
                                            Err(error) => {
                                                results.set(next, WorkerTaskResult::Failure(error.code));
                                                completed = completed + 1;
                                                next = next + 1;
                                                Result<Worker, IoError> restarted = this.restartAt(i);
                                                match (restarted) {
                                                    Ok(worker) => { }
                                                    Err(restartError) => { this.terminate(); return Err(restartError); }
                                                }
                                            }
                                        }
                                    }
                                }
                                None => {
                                    results.set(slot, WorkerTaskResult::Failure(9));
                                    slots.set(i, -1);
                                    completed = completed + 1;
                                    Result<Worker, IoError> restarted = this.restartAt(i);
                                    match (restarted) {
                                        Ok(worker) => { }
                                        Err(restartError) => { this.terminate(); return Err(restartError); }
                                    }
                                }
                            }
                        }
                        Err(error) => {
                            results.set(slot, WorkerTaskResult::Failure(error.code));
                            slots.set(i, -1);
                            completed = completed + 1;
                            Result<Worker, IoError> restarted = this.restartAt(i);
                            match (restarted) {
                                Ok(worker) => { }
                                Err(restartError) => { this.terminate(); return Err(restartError); }
                            }
                        }
                    }
                } else if (next < total) {
                    Result<i64, IoError> sent = this.workers.get(i).send(tasks.get(next));
                    match (sent) {
                        Ok(ignored) => { slots.set(i, next); next = next + 1; }
                        Err(error) => {
                            results.set(next, WorkerTaskResult::Failure(error.code));
                            completed = completed + 1;
                            next = next + 1;
                            Result<Worker, IoError> restarted = this.restartAt(i);
                            match (restarted) {
                                Ok(worker) => { }
                                Err(restartError) => { this.terminate(); return Err(restartError); }
                            }
                        }
                    }
                }
                i = i + 1;
            }
        }
        return Ok(results);
    }

    fn restartAt(i64 index) -> Result<Worker, IoError> {
        this.workers.get(index).terminate();
        Result<Worker, IoError> spawned = Worker::Spawn(this.command);
        match (spawned) {
            Ok(worker) => {
                this.workers.set(index, worker);
                return Ok(worker);
            }
            Err(error) => { return Err(error); }
        }
    }

    // 正常关闭所有 worker；任一失败则强制清理整池。
    pub fn close() -> Result<i64, IoError> {
        i64 i = 0;
        while (i < this.workers.len) {
            Result<ProcessStatus, IoError> closed = this.workers.get(i).close();
            match (closed) {
                Ok(status) => { }
                Err(error) => { this.terminate(); return Err(error); }
            }
            i = i + 1;
        }
        return Ok(this.workers.len);
    }

    // 强制清理整池；忽略单个 worker 的清理错误，返回尝试过的 worker 数量。
    pub fn terminate() -> i64 {
        i64 i = 0;
        while (i < this.workers.len) {
            this.workers.get(i).terminate();
            i = i + 1;
        }
        return this.workers.len;
    }
}
