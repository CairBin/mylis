// Unix domain socket 的事件循环适配：组合通用 EventLoop + UDS handler。
// 仅 POSIX 可用；Windows 下 UnixListener/UnixStream 会以 -95 返回不支持。
import { EventLoop } from "EventLoop.myl";
import { FdHandler } from "FdHandler.myl";
import { UnixListener } from "UnixListener.myl";
import { UnixStream } from "UnixStream.myl";
import { UnixListenerHandler } from "UnixListenerHandler.myl";
import { UnixStreamHandler } from "UnixStreamHandler.myl";
import { IoError } from "IoError.myl";

class UnixListenerAdapter {
    UnixListener listener;
    UnixListenerHandler handler;

    pub fn init(UnixListener value, UnixListenerHandler hd) -> void {
        this.listener = value;
        this.handler = hd;
    }

    pub fn onFdReadable(i64 fd) -> void {
        this.handler.onAccept(this.listener);
    }

    pub fn onFdWritable(i64 fd) -> void {
    }

    pub fn onFdError(i64 fd, IoError error) -> void {
        this.handler.onListenerError(this.listener, error);
    }
}

class UnixStreamAdapter {
    UnixStream stream;
    UnixStreamHandler handler;

    pub fn init(UnixStream value, UnixStreamHandler hd) -> void {
        this.stream = value;
        this.handler = hd;
    }

    pub fn onFdReadable(i64 fd) -> void {
        this.handler.onReadable(this.stream);
    }

    pub fn onFdWritable(i64 fd) -> void {
        this.handler.onWritable(this.stream);
    }

    pub fn onFdError(i64 fd, IoError error) -> void {
        this.handler.onError(this.stream, error);
    }
}

pub class UnixEventLoop {
    EventLoop loop;

    pub fn init(EventLoop l) -> void {
        this.loop = l;
    }

    pub fn addListener(UnixListener listener, UnixListenerHandler handler) -> void {
        listener.setNonblocking(true);
        UnixListenerAdapter adapter = new UnixListenerAdapter(listener, handler);
        FdHandler fdHandler = adapter;
        this.loop.add(listener.nativeFd(), fdHandler);
    }

    pub fn addStream(UnixStream stream, UnixStreamHandler handler) -> void {
        stream.setNonblocking(true);
        UnixStreamAdapter adapter = new UnixStreamAdapter(stream, handler);
        FdHandler fdHandler = adapter;
        this.loop.add(stream.nativeFd(), fdHandler);
    }

    pub fn setWriteInterest(UnixStream stream, bool enabled) -> void {
        this.loop.setWriteInterest(stream.nativeFd(), enabled);
    }

    pub fn removeListener(UnixListener listener) -> void {
        this.loop.remove(listener.nativeFd());
    }

    pub fn removeStream(UnixStream stream) -> void {
        this.loop.remove(stream.nativeFd());
    }
}
