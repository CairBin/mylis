// CSV：RFC 4180 风格的逗号分隔文本解析与序列化。
// 支持双引号字段、字段内逗号/换行、"" 转义、CRLF/LF 行结束；空输入返回空表。
// 解析结果是 Vec<Vec<string>>，不依赖文件系统。
import { Str } from "core/Str";
import { Vec } from "Vec.myl";
import { StringBuilder } from "StringBuilder.myl";
import { fmt_i64 } from "core/Fmt";

pub class Csv {
    pub static fn Parse(string text) -> Result<Vec<Vec<string>>, string> {
        Vec<Vec<string>> rows = new Vec<Vec<string>>();
        u8[] b = Str::Bytes(text);
        i64 n = b.len() as i64;
        i64 i = 0;
        while (i < n) {
            Vec<string> row = new Vec<string>();
            bool endRow = false;
            while (!endRow) {
                StringBuilder field = new StringBuilder();
                if (i < n && b[i] == 34) {
                    i = i + 1;
                    i64 start = i;
                    bool closed = false;
                    while (i < n) {
                        if (b[i] == 34) {
                            if (i + 1 < n && b[i + 1] == 34) {
                                field.append(csv_bytes(b, start, i - start));
                                field.append("\"");
                                i = i + 2;
                                start = i;
                            } else {
                                field.append(csv_bytes(b, start, i - start));
                                i = i + 1;
                                closed = true;
                                break;
                            }
                        } else {
                            i = i + 1;
                        }
                    }
                    if (!closed) {
                        return Err("CSV 引号字段未闭合（字节 " + fmt_i64(i) + "）");
                    }
                    if (i < n && b[i] != 44 && b[i] != 10 && b[i] != 13) {
                        return Err("CSV 引号字段后存在多余字符（字节 " + fmt_i64(i) + "）");
                    }
                } else {
                    i64 start = i;
                    while (i < n && b[i] != 44 && b[i] != 10 && b[i] != 13) {
                        if (b[i] == 34) {
                            return Err("CSV 未加引号的字段包含引号（字节 " + fmt_i64(i) + "）");
                        }
                        i = i + 1;
                    }
                    field.append(csv_bytes(b, start, i - start));
                }
                row.push(field.toString());
                if (i >= n) {
                    endRow = true;
                } else if (b[i] == 44) {
                    i = i + 1;
                } else if (b[i] == 10) {
                    i = i + 1;
                    endRow = true;
                } else if (b[i] == 13) {
                    i = i + 1;
                    if (i < n && b[i] == 10) {
                        i = i + 1;
                    }
                    endRow = true;
                } else {
                    return Err("CSV 字段分隔符无效（字节 " + fmt_i64(i) + "）");
                }
            }
            rows.push(row);
        }
        return Ok(rows);
    }

    pub static fn Stringify(Vec<Vec<string>> rows) -> string {
        StringBuilder out = new StringBuilder();
        i64 r = 0;
        while (r < rows.len()) {
            Vec<string> row = rows.get(r);
            i64 c = 0;
            while (c < row.len()) {
                if (c > 0) {
                    out.append(",");
                }
                string value = row.get(c);
                if (csv_needs_quote(value)) {
                    out.append(csv_quote(value));
                } else {
                    out.append(value);
                }
                c = c + 1;
            }
            if (r + 1 < rows.len()) {
                out.append("\n");
            }
            r = r + 1;
        }
        return out.toString();
    }
}

fn csv_bytes(u8[] b, i64 start, i64 len) -> string {
    if (len <= 0) {
        return "";
    }
    u8[] out = new u8[len];
    i64 i = 0;
    while (i < len) {
        out[i] = b[start + i];
        i = i + 1;
    }
    return Str::FromBytes(out);
}

fn csv_needs_quote(string value) -> bool {
        if (value == "") {
            return true;
        }
        if (Str::Contains(value, ",") || Str::Contains(value, "\"")
            || Str::Contains(value, "\n") || Str::Contains(value, "\r")) {
            return true;
        }
        u8[] b = Str::Bytes(value);
        if (b.len() > 0) {
            if (b[0] == 32 || b[0] == 9) {
                return true;
            }
            if (b[b.len() - 1] == 32 || b[b.len() - 1] == 9) {
                return true;
            }
        }
        return false;
    }

fn csv_quote(string value) -> string {
        StringBuilder out = new StringBuilder();
        out.append("\"");
        i64 i = 0;
        while (i < Str::Len(value) as i64) {
            string ch = Str::CharAt(value, i as u64);
            if (ch == "\"") {
                out.append("\"\"");
            } else {
                out.append(ch);
            }
            i = i + 1;
        }
        out.append("\"");
        return out.toString();
    }
