// 正则匹配结果：字节偏移区间。
import { Str } from "core/Str";

pub class RegexMatch {
    pub i64 start;
    pub i64 end;

    pub fn init(i64 begin, i64 finish) -> void {
        this.start = begin;
        this.end = finish;
    }

    pub fn text(string source) -> string {
        if (this.start < 0 || this.end < this.start) {
            return "";
        }
        u8[] data = Str::Bytes(source);
        if (this.end > data.len() as i64) {
            return "";
        }
        i64 count = this.end - this.start;
        u8[] part = new u8[count as u64];
        i64 i = 0;
        while (i < count) {
            part[i as u64] = data[(this.start + i) as u64];
            i = i + 1;
        }
        return Str::FromBytes(part);
    }
}

