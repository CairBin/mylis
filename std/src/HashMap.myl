// HashMap<K, V>：开放寻址哈希表，要求 K: Hash + Eq。
// 采用线性探测、墓碑删除；负载因子超过 3/4 时扩容并重建。
// 不保证遍历顺序；大表扩容是 O(n)，常规查找/插入/删除期望 O(1)。
import { Eq } from "core/Eq";
import { Hash } from "core/Hash";
import { Vec } from "Vec.myl";

pub class HashMap<K: Hash + Eq, V> {
    pub K[] keys;
    pub V[] values;
    pub bool[] used;
    pub bool[] dead;
    pub i64 count;
    pub i64 deadCount;
    pub i64 cap;

    pub fn init() -> void {
        this.keys = new K[0];
        this.values = new V[0];
        this.used = new bool[0];
        this.dead = new bool[0];
        this.count = 0;
        this.deadCount = 0;
        this.cap = 0;
    }

    fn hashIndex(K key) -> i64 {
        return (key.hash() % (this.cap as u64)) as i64;
    }

    fn find(K key) -> i64 {
        if (this.cap == 0) {
            return -1;
        }
        i64 start = this.hashIndex(key);
        i64 at = start;
        while (true) {
            if (!this.used[at]) {
                if (!this.dead[at]) {
                    return -1;
                }
            } else {
                if (this.keys[at].equals(key)) {
                    return at;
                }
            }
            at = (at + 1) % this.cap;
            if (at == start) {
                return -1;
            }
        }
        return -1;
    }

    fn rawInsert(K key, V value) -> void {
        i64 at = this.hashIndex(key);
        while (this.used[at]) {
            at = (at + 1) % this.cap;
        }
        bool reused = this.dead[at];
        this.keys[at] = key;
        this.values[at] = value;
        this.used[at] = true;
        this.dead[at] = false;
        if (reused) {
            this.deadCount = this.deadCount - 1;
        }
        this.count = this.count + 1;
    }

    fn resize(i64 ncap) -> void {
        K[] oldKeys = this.keys;
        V[] oldValues = this.values;
        bool[] oldUsed = this.used;
        i64 oldCap = this.cap;
        this.keys = new K[ncap];
        this.values = new V[ncap];
        this.used = new bool[ncap];
        this.dead = new bool[ncap];
        this.cap = ncap;
        this.count = 0;
        this.deadCount = 0;
        i64 i = 0;
        while (i < oldCap) {
            if (oldUsed[i]) {
                this.rawInsert(oldKeys[i], oldValues[i]);
            }
            i = i + 1;
        }
    }

    fn ensureCapacity() -> void {
        if (this.cap == 0) {
            this.resize(8);
            return;
        }
        if ((this.count + this.deadCount + 1) * 4 >= this.cap * 3) {
            this.resize(this.cap * 2);
        }
    }

    pub fn set(K key, V value) -> void {
        i64 at = this.find(key);
        if (at >= 0) {
            this.values[at] = value;
            return;
        }
        this.ensureCapacity();
        this.rawInsert(key, value);
    }

    pub fn insert(K key, V value) -> bool {
        i64 at = this.find(key);
        if (at >= 0) {
            this.values[at] = value;
            return false;
        }
        this.ensureCapacity();
        this.rawInsert(key, value);
        return true;
    }

    pub fn get(K key) -> Option<V> {
        i64 at = this.find(key);
        if (at < 0) {
            return None;
        }
        return Some(this.values[at]);
    }

    pub fn containsKey(K key) -> bool {
        return this.find(key) >= 0;
    }

    pub fn getOr(K key, V fallback) -> V {
        i64 at = this.find(key);
        if (at < 0) {
            return fallback;
        }
        return this.values[at];
    }

    pub fn remove(K key) -> Option<V> {
        i64 at = this.find(key);
        if (at < 0) {
            return None;
        }
        V value = this.values[at];
        this.used[at] = false;
        this.dead[at] = true;
        this.count = this.count - 1;
        this.deadCount = this.deadCount + 1;
        return Some(value);
    }

    pub fn keys() -> Vec<K> {
        Vec<K> out = new Vec<K>();
        i64 i = 0;
        while (i < this.cap) {
            if (this.used[i]) {
                out.push(this.keys[i]);
            }
            i = i + 1;
        }
        return out;
    }

    pub fn values() -> Vec<V> {
        Vec<V> out = new Vec<V>();
        i64 i = 0;
        while (i < this.cap) {
            if (this.used[i]) {
                out.push(this.values[i]);
            }
            i = i + 1;
        }
        return out;
    }

    pub fn clear() -> void {
        i64 i = 0;
        while (i < this.cap) {
            this.used[i] = false;
            this.dead[i] = false;
            i = i + 1;
        }
        this.count = 0;
        this.deadCount = 0;
    }

    pub fn len() -> i64 {
        return this.count;
    }

    pub fn isEmpty() -> bool {
        return this.count == 0;
    }
}
