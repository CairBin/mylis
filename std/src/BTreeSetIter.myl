// BTreeSet<T> 的显式迭代器；按元素升序返回。
import { Ord } from "core/Ord";
import { BTreeSet } from "BTreeSet.myl";
import { Vec } from "Vec.myl";

pub class BTreeSetIter<T: Ord> {
    Vec<T> values;
    i64 index;

    pub fn init(BTreeSet<T> set) -> void {
        this.values = set.toVec();
        this.index = 0;
    }

    pub fn next() -> Option<T> {
        if (this.index >= this.values.len()) {
            return None;
        }
        T value = this.values.get(this.index);
        this.index = this.index + 1;
        return Some(value);
    }
}

pub fn iter_btree_set<T: Ord>(BTreeSet<T> set) -> BTreeSetIter<T> {
    return new BTreeSetIter<T>(set);
}
