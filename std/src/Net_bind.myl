// std TCP native 后端绑定（Rust staticlib，C ABI）。
// 句柄是不透明 i64；u8[] 与 File 后端使用同一数组布局。
@header("mylis_net.h")
pub unsafe fn mylis_tcp_bind(i8* address) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_tcp_listener_port(i64 handle) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_tcp_accept(i64 handle) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_tcp_connect(i8* address) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_tcp_listener_close(i64 handle) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_tcp_stream_close(i64 handle) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_tcp_stream_fd(i64 handle) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_tcp_listener_fd(i64 handle) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_tcp_listener_set_nonblocking(i64 handle, i32 enabled) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_tcp_stream_set_nonblocking(i64 handle, i32 enabled) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_tcp_stream_set_timeout(i64 handle, i64 milliseconds) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_tcp_stream_read(i64 handle, u8[] data, i64 offset, i64 count) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_tcp_stream_write(i64 handle, u8[] data, i64 offset, i64 count) -> i64;

// ---- socket options ----
@header("mylis_net.h")
pub unsafe fn mylis_tcp_stream_set_nodelay(i64 handle, i32 enabled) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_tcp_stream_set_keepalive(i64 handle, i32 enabled) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_tcp_stream_set_recv_buffer(i64 handle, i32 bytes) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_tcp_stream_set_send_buffer(i64 handle, i32 bytes) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_tcp_listener_set_reuse_address(i64 handle, i32 enabled) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_udp_set_reuse_address(i64 handle, i32 enabled) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_udp_set_broadcast(i64 handle, i32 enabled) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_udp_set_ttl(i64 handle, i32 ttl) -> i64;

// ---- Unix domain socket ----
@header("mylis_net.h")
pub unsafe fn mylis_unix_bind(i8* path) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_unix_accept(i64 handle) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_unix_connect(i8* path) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_unix_listener_fd(i64 handle) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_unix_stream_fd(i64 handle) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_unix_listener_close(i64 handle) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_unix_stream_close(i64 handle) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_unix_listener_set_nonblocking(i64 handle, i32 enabled) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_unix_stream_set_nonblocking(i64 handle, i32 enabled) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_unix_stream_set_timeout(i64 handle, i64 milliseconds) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_unix_stream_read(i64 handle, u8[] data, i64 offset, i64 count) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_unix_stream_write(i64 handle, u8[] data, i64 offset, i64 count) -> i64;

@header("mylis_net.h")
pub unsafe fn mylis_unix_remove(i8* path) -> i64;
