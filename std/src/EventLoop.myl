// 单线程通用 fd 事件循环：事件后端等待 fd 就绪 -> Mylis 主线程分发 FdHandler。
// Linux 使用 epoll，其他 POSIX 使用 poll 后备，Windows 使用 Winsock WSAPoll；Rust 后端不执行 Mylis 回调。
// 不直接依赖 TCP/UDP/File；协议适配器和文件完成泵通过类组合接入。
import { FdHandler } from "FdHandler.myl";
import { EventPump } from "EventPump.myl";
import { IoError } from "IoError.myl";
import { mylis_event_new, mylis_event_add, mylis_event_modify, mylis_event_remove, mylis_event_wait, mylis_event_close } from "Event_bind.myl";

class EventEntry {
    i64 fd;
    FdHandler handler;

    pub fn init(i64 d, FdHandler hd) -> void {
        this.fd = d;
        this.handler = hd;
    }
}

class PumpEntry {
    EventPump pump;

    pub fn init(EventPump p) -> void {
        this.pump = p;
    }
}

pub class EventLoop {
    EventEntry[] entries;
    i32 count;
    i32 capacity;
    PumpEntry[] pumps;
    i32 pumpCount;
    i32 pumpCapacity;
    i64 eventHandle;
    bool stopped;

    pub fn init() -> void {
        this.capacity = 8;
        this.entries = new EventEntry[this.capacity];
        this.count = 0;
        this.pumpCapacity = 8;
        this.pumps = new PumpEntry[this.pumpCapacity];
        this.pumpCount = 0;
        this.stopped = false;
        unsafe {
            this.eventHandle = mylis_event_new();
        }
    }

    fn grow() -> void {
        this.capacity = this.capacity * 2;
        EventEntry[] ne = new EventEntry[this.capacity];
        i32 i = 0;
        while (i < this.count) {
            ne[i] = this.entries[i];
            i = i + 1;
        }
        this.entries = ne;
    }

    fn growPumps() -> void {
        this.pumpCapacity = this.pumpCapacity * 2;
        PumpEntry[] np = new PumpEntry[this.pumpCapacity];
        i32 i = 0;
        while (i < this.pumpCount) {
            np[i] = this.pumps[i];
            i = i + 1;
        }
        this.pumps = np;
    }

    fn findFd(i64 fd) -> i32 {
        i32 i = 0;
        while (i < this.count) {
            if (this.entries[i].fd == fd) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    fn removeAt(i32 idx) -> void {
        i32 j = idx;
        while (j + 1 < this.count) {
            this.entries[j] = this.entries[j + 1];
            j = j + 1;
        }
        this.count = this.count - 1;
    }

    fn hasPendingPump() -> bool {
        i32 i = 0;
        while (i < this.pumpCount) {
            if (this.pumps[i].pump.hasPending()) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    fn pumpAll() -> void {
        i32 i = 0;
        while (i < this.pumpCount) {
            this.pumps[i].pump.pump();
            i = i + 1;
        }
    }

    pub fn add(i64 fd, FdHandler handler) -> void {
        if (this.findFd(fd) >= 0) {
            return;
        }
        if (this.count >= this.capacity) {
            this.grow();
        }
        i32 i = this.count;
        this.entries[i] = new EventEntry(fd, handler);
        this.count = this.count + 1;
        unsafe {
            mylis_event_add(this.eventHandle, fd);
        }
    }

    pub fn setWriteInterest(i64 fd, bool enabled) -> void {
        i32 idx = this.findFd(fd);
        if (idx < 0) {
            return;
        }
        i32 flag = 0;
        if (enabled) {
            flag = 1;
        }
        unsafe {
            mylis_event_modify(this.eventHandle, fd, flag);
        }
    }

    pub fn remove(i64 fd) -> void {
        i32 idx = this.findFd(fd);
        if (idx < 0) {
            return;
        }
        unsafe {
            mylis_event_remove(this.eventHandle, fd);
        }
        this.removeAt(idx);
    }

    // 挂入不基于 fd 的完成泵（例如 FilePump）；run() 每轮都会调用 pump()。
    pub fn addPump(EventPump pump) -> void {
        if (this.pumpCount >= this.pumpCapacity) {
            this.growPumps();
        }
        this.pumps[this.pumpCount] = new PumpEntry(pump);
        this.pumpCount = this.pumpCount + 1;
    }

    pub fn run() -> void {
        if (this.eventHandle < 0) {
            this.stopped = true;
            return;
        }
        this.stopped = false;
        while (!this.stopped && (this.count > 0 || this.hasPendingPump())) {
            i32 n = this.count;
            i32 cap = n;
            if (cap == 0) {
                cap = 1;
            }
            i64[] fds = new i64[cap];
            i64[] revents = new i64[cap];
            i32 rc = 0;
            unsafe {
                rc = mylis_event_wait(this.eventHandle, 100, fds, revents, n);
            }
            if (rc < 0) {
                this.stopped = true;
                break;
            }
            i32 i = 0;
            while (i < rc) {
                i64 fd = fds[i];
                i64 mask = revents[i];
                i32 idx = this.findFd(fd);
                if (idx >= 0) {
                    FdHandler handler = this.entries[idx].handler;
                    if ((mask & 1) != 0) {
                        handler.onFdReadable(fd);
                    }
                    if ((mask & 4) != 0) {
                        handler.onFdWritable(fd);
                    }
                    if ((mask & 24) != 0 || (mask & 32) != 0) {
                        handler.onFdError(fd, new IoError(5));
                    }
                }
                i = i + 1;
            }
            this.pumpAll();
        }
    }

    pub fn stop() -> void {
        this.stopped = true;
    }

    pub fn close() -> void {
        this.stopped = true;
        i32 i = 0;
        while (i < this.pumpCount) {
            this.pumps[i].pump.shutdown();
            i = i + 1;
        }
        if (this.eventHandle > 0) {
            unsafe {
                mylis_event_close(this.eventHandle);
            }
        }
        this.eventHandle = -1;
        this.count = 0;
        this.pumpCount = 0;
    }
}
