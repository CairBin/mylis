// SHA-1（纯 Mylis，按字节处理，返回小写十六进制）。
import { Str } from "core/Str";
import { StringBuilder } from "StringBuilder.myl";

pub class Sha1 {
    pub static fn Hash(string message) -> string {
        return Sha1::HashBytes(Str::Bytes(message));
    }

    static fn rotl(u32 value, u32 bits) -> u32 {
        return (value << bits) | (value >> ((32 as u32) - bits));
    }

    static fn hex(u8[] value) -> string {
        StringBuilder out = new StringBuilder();
        string digits = "0123456789abcdef";
        i64 i = 0;
        while (i < (value.len() as i64)) {
            u8 b = value[i];
            out.append(Str::Substring(digits, ((b >> 4) as u64), 1));
            out.append(Str::Substring(digits, ((b & 15) as u64), 1));
            i = i + 1;
        }
        return out.toString();
    }

    pub static fn HashBytes(u8[] data) -> string {
        u32[] k = [
            (1518500249) as u32, (1859775393) as u32, (-1894007588) as u32, (-899497514) as u32
        ];
        u32[] h = [
            (1732584193) as u32, (-271733879) as u32, (-1732584194) as u32,
            (271733878) as u32, (-1009589776) as u32
        ];

        i64 length = data.len() as i64;
        i64 total = ((length + 9 + 63) / 64) * 64;
        u8[] padded = new u8[total];
        i64 i = 0;
        while (i < length) {
            padded[i] = data[i];
            i = i + 1;
        }
        padded[length] = 128 as u8;
        u64 bitLength = (length as u64) * (8 as u64);
        i32 j = 0;
        while (j < 8) {
            padded[total - 1 - (j as i64)] = (bitLength >> ((j * 8) as u64)) as u8;
            j = j + 1;
        }

        i64 block = 0;
        while (block < total / 64) {
            u32[] w = new u32[80];
            i32 t = 0;
            while (t < 16) {
                i64 off = block * 64 + (t as i64) * 4;
                w[t] = ((padded[off] as u32) << 24)
                    | ((padded[off + 1] as u32) << 16)
                    | ((padded[off + 2] as u32) << 8)
                    | (padded[off + 3] as u32);
                t = t + 1;
            }
            t = 16;
            while (t < 80) {
                u32 value = w[t - 3] ^ w[t - 8] ^ w[t - 14] ^ w[t - 16];
                w[t] = Sha1::rotl(value, 1);
                t = t + 1;
            }

            u32 a = h[0];
            u32 b = h[1];
            u32 c = h[2];
            u32 d = h[3];
            u32 e = h[4];
            t = 0;
            while (t < 80) {
                u32 f = 0;
                u32 kk = 0;
                if (t < 20) {
                    f = (b & c) | ((~b) & d);
                    kk = k[0];
                } else if (t < 40) {
                    f = b ^ c ^ d;
                    kk = k[1];
                } else if (t < 60) {
                    f = (b & c) | (b & d) | (c & d);
                    kk = k[2];
                } else {
                    f = b ^ c ^ d;
                    kk = k[3];
                }
                u32 temp = Sha1::rotl(a, 5) + f + e + kk + w[t];
                e = d;
                d = c;
                c = Sha1::rotl(b, 30);
                b = a;
                a = temp;
                t = t + 1;
            }
            h[0] = h[0] + a;
            h[1] = h[1] + b;
            h[2] = h[2] + c;
            h[3] = h[3] + d;
            h[4] = h[4] + e;
            block = block + 1;
        }

        u8[] digest = new u8[20];
        i32 word = 0;
        while (word < 5) {
            digest[(word * 4) as i64] = (h[word] >> 24) as u8;
            digest[(word * 4 + 1) as i64] = (h[word] >> 16) as u8;
            digest[(word * 4 + 2) as i64] = (h[word] >> 8) as u8;
            digest[(word * 4 + 3) as i64] = h[word] as u8;
            word = word + 1;
        }
        return Sha1::hex(digest);
    }
}
