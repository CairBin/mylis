pub unsafe fn mylis_process_last_signal() -> i64;

@header("mylis_process.h")
pub unsafe fn mylis_process_last_stdout() -> i8*;

@header("mylis_process.h")
pub unsafe fn mylis_process_last_stderr() -> i8*;

