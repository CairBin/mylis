// Worker 侧行协议服务端：读一行、交给 handler、把返回值打印成一行。
// 收到保留控制行 "__shutdown__" 时直接退出，Worker::shutdown 依赖这个约定。
import { WorkerHandler } from "WorkerHandler.myl";
import { Stdio } from "Stdio.myl";
import { println } from "Io.myl";

pub class WorkerServer {
    pub static fn Run(WorkerHandler handler) -> i32 {
        while (true) {
            Option<string> line = Stdio::ReadLine();
            match (line) {
                None => { return 0; }
                Some(request) => {
                    if (request == "__shutdown__") {
                        return 0;
                    }
                    string response = handler.handle(request);
                    println(response);
                }
            }
        }
        return 0;
    }
}
