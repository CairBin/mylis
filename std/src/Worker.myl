// Worker：基于 Popen2 的进程隔离通信层。
// 每行一条消息，调用方约定用 JSON 序列化；不共享 Mylis 对象、不共享 GC 堆。
// 子进程 stderr 继承父进程；不做非阻塞/select。
import { IoError } from "IoError.myl";
import { Process } from "Process.myl";
import { ProcessPipe } from "ProcessPipe.myl";
import { ProcessStatus } from "ProcessStatus.myl";
import { Str } from "core/Str";

pub class Worker {
    ProcessPipe pipe;

    pub fn init(ProcessPipe p) -> void {
        this.pipe = p;
    }

    pub static fn Spawn(string command) -> Result<Worker, IoError> {
        Result<ProcessPipe, IoError> opened = Process::Popen2(command);
        match (opened) {
            Ok(pipe) => { return Ok(new Worker(pipe)); }
            Err(error) => { return Err(error); }
        }
    }

    pub fn pid() -> i64 {
        return this.pipe.pid();
    }

    // 发送一条消息；消息内的换行会破坏行协议，请用 Json::Stringify 生成。
    pub fn send(string message) -> Result<i64, IoError> {
        string framed = message + "\n";
        return this.pipe.write(Str::Bytes(framed));
    }

    // 读取一条响应；子进程关闭 stdout 后返回 None。
    pub fn recv() -> Result<Option<string>, IoError> {
        return this.pipe.readLine();
    }

    // 带超时读取一条响应；超时返回 IoError(110)。
    pub fn recvTimeout(i64 timeoutMs) -> Result<Option<string>, IoError> {
        return this.pipe.readLineTimeout(timeoutMs);
    }

    pub fn call(string message) -> Result<string, IoError> {
        return this.callCore(message, -1);
    }

    // 带超时的 call；超时返回 IoError(110)。
    pub fn callTimeout(string message, i64 timeoutMs) -> Result<string, IoError> {
        return this.callCore(message, timeoutMs);
    }

    fn callCore(string message, i64 timeoutMs) -> Result<string, IoError> {
        Result<i64, IoError> sent = this.send(message);
        match (sent) {
            Err(sendError) => { return Err(sendError); }
            Ok(ignored) => {
                Result<Option<string>, IoError> received = this.recvTimeout(timeoutMs);
                match (received) {
                    Ok(value) => {
                        match (value) {
                            Some(text) => { return Ok(text); }
                            None => { return Err(new IoError(9)); }
                        }
                    }
                    Err(recvError) => { return Err(recvError); }
                }
            }
        }
    }

    // 通知 WorkerServer 退出并等待；按行读 stdin 的普通 worker 会在 EOF 时退出。
    pub fn shutdown() -> Result<ProcessStatus, IoError> {
        Result<i64, IoError> sent = this.send("__shutdown__");
        match (sent) {
            Err(sendError) => { return Err(sendError); }
            Ok(ignored) => { return this.close(); }
        }
    }

    pub fn close() -> Result<ProcessStatus, IoError> {
        return this.pipe.close();
    }

    // 强制结束 worker；不等待它自己退出。
    pub fn terminate() -> Result<ProcessStatus, IoError> {
        return this.pipe.terminate();
    }
}
